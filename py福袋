    def _anti_burn_sleep_loop(self, start_hour, end_hour, sleep_name="防烧屏休眠"):
        """
        [V9.9 极致护机版] 午休/夜间深度息屏与下拉刷新满血唤醒引擎
        """
        import datetime

        import time

        self.t_print(f"{sleep_name}", "当前时间已进入设定时段，准备进入深度息屏休眠...")

        # 1. 退出直播间，回到列表安全区
        self.op.adb_key_event(self.device_id, 4)
        self.op.delay(2)
        self.op.adb_key_event(self.device_id, 4)
        self.op.delay(3)

        # 2. 彻底息屏锁屏，进入 0 功耗状态
        self.t_print(f"{sleep_name}", "已退至外部安全区，正在发送底层物理息屏指令...")
        self.op.adb_key_event(self.device_id, 26)
        self.t_print(f"{sleep_name}", "屏幕已关闭！抖音已进入后台打盹模式。")

        while True:
            now = datetime.datetime.now()
            current_time_val = now.hour + now.minute / 100.0

            if start_hour > end_hour:
                still_sleeping = current_time_val >= start_hour or current_time_val < end_hour
            else:
                still_sleeping = start_hour <= current_time_val < end_hour

            # ==========================================
            # ★ 苏醒：静默亮屏与进程存活检测 (真·静默版)
            # ==========================================
            if not still_sleeping:
                # 整个苏醒过程只保留这一句开场白
                self.t_print(f"{sleep_name}苏醒", "休息结束！屏幕已唤醒，正在静默重连业务...")
                self.op.adb_key_event(self.device_id, 224)
                self.op.delay(3.5)  # 给屏幕总线和后台 App 恢复活力的时间

                is_foreground = False
                try:
                    import subprocess
                    cmd_act = f"adb -s {self.device_id} shell dumpsys activity activities"
                    out_act = subprocess.check_output(cmd_act, shell=True, timeout=3).decode('utf-8', 'ignore')
                    for line in out_act.splitlines():
                        if "mResumedActivity" in line and "com.ss.android.ugc.aweme" in line:
                            is_foreground = True
                            break

                    if not is_foreground:
                        cmd_win = f"adb -s {self.device_id} shell dumpsys window"
                        out_win = subprocess.check_output(cmd_win, shell=True, timeout=3).decode('utf-8', 'ignore')
                        for line in out_win.splitlines():
                            if (
                                    "mCurrentFocus" in line or "mFocusedApp" in line) and "com.ss.android.ugc.aweme" in line:
                                is_foreground = True
                                break
                except Exception:
                    pass

                # 逻辑分流处理
                if not is_foreground:
                    # 只有在真出问题（被杀了）需要拉起 App 时，才打印一条警告
                    self.t_print(f"{sleep_name}苏醒", "抖音已被系统清理，正在重新拉起 App...")
                    self.op.start_app(self.device_id)
                    self.op.delay(10.0)
                    return

                # 如果抖音依然存活，连废话都不说，直接静默截图并执行下拉刷新
                self.op.get_screenshot(self.device_id, silent=True)
                sc_check = self.op.cv_imread("pic/screenshot.png")

                if sc_check is not None:
                    h, w = sc_check.shape[:2]
                    # 只扫上半屏，速度极快
                    roi_top = sc_check[0:int(h * 0.4), 0:w]
                    res_ocr = self.op.ocr.ocr(roi_top, cls=False)
                    text_all = "".join([line[1][0] for line in res_ocr[0]]) if res_ocr and res_ocr[0] else ""

                    # ★ 核心改动：如果是列表页，执行拟人化下拉刷新！
                    if "正在直播" in text_all or "批量管理" in text_all:
                        list_name = "【关注列表】" if "批量管理" in text_all else "【直播间列表】"
                        self.t_print(f"{sleep_name}苏醒", f"确认处于 {list_name}，执行【下拉刷新】获取最新数据...")

                        # 模拟手指从屏幕上方 30% 处狠狠滑到下方 75% 处，触发下拉刷新动画
                        self.op.swipe_custom(self.device_id, w // 2, int(h * 0.3), w // 2, int(h * 0.75), duration=400)

                        self.t_print(f"{sleep_name}苏醒", "数据刷新中，等待 5 秒...")
                        self.op.delay(5.0)
                    else:
                        self.t_print(f"{sleep_name}苏醒", "画面不在列表页，跳过下拉刷新，交由导航自救...")

                self.t_print(f"{sleep_name}苏醒", "页面状态校准完毕，交还控制权给主控引擎！")
                return

            # 如果在此期间你按了强制切房（n键），直接打断休眠强行起床！
            if getattr(self, 'force_switch_flag', False):
                self.t_print("强制干预", "收到强制唤醒指令，提前结束休眠，强行苏醒！")
                self.op.adb_key_event(self.device_id, 224)
                self.op.delay(2.5)
                return

            # ==========================================
            # ★ 蛰伏：0 算力安静挂机
            # ==========================================
            time.sleep(30)  # 彻底黑屏，不发任何指令，不截图，只看时间

