                            h_sc, w_sc = sc.shape[:2]
                            res_close = self.op.ocr.ocr(sc[0:int(h_sc * 0.5), 0:w_sc], cls=False)
                            if res_close and res_close[0]:
                                close_txt = "".join([l[1][0] for l in res_close[0]])
                                if "直播已结束" in close_txt or "主播暂时离开" in close_txt or "结束直播" in close_txt:
                                    is_closed = True

                        if is_closed:
                            self.t_print("提示", "主播已下播，转入模式1寻找新直播间")
                            run_mode = 1
                            fudai_info = None
                            execute_room_switch()  # 触发切房拦截器
                            break  # 跳出哨兵循环，由外层执行切房

                        # --- 2. 扫描福袋图标 (调用原生搜索引擎) ---
                        fudai_info = self._search_fudai_loop()

                        if not fudai_info:
                            no_fudai_count += 1
                            if no_fudai_count >= 4:
                                self.t_print("刷新", "2分钟未见福袋，上下滑动刷新直播间...")
                                w, h = self.dm.data["resolution"]
                                self.op.swipe_custom(self.device_id, w // 2, int(h * 0.75), w // 2,
                                                     int(h * 0.25), duration=300)
                                self.op.delay(5.0)
                                self.op.swipe_custom(self.device_id, w // 2, int(h * 0.25), w // 2,
                                                     int(h * 0.75), duration=300)
                                self.op.delay(10.0)
                                no_fudai_count = 0
                            else:
                                self.op.delay(30)
                            continue

                        # --- 3. 发现福袋，打开面板进行 T3 确权 ---
                        no_fudai_count = 0
                        ftype, pos = fudai_info
                        self.op.click(self.device_id, (pos['cx'], pos['cy']))
                        self.op.delay(2.5)

                        # --- 内置轻量级时间提取器 ---
                        def extract_time_lite():
                            self.op.get_screenshot(self.device_id, silent=True)
                            sc_t = self.op.cv_imread("pic/screenshot.png")
                            if sc_t is None: return -1
                            h_t, w_t = sc_t.shape[:2]
                            res_t = self.op.ocr.ocr(sc_t[int(h_t * 0.2):int(h_t * 0.8), 0:w_t], cls=False)
                            if not res_t or not res_t[0]: return -1
                            t_str = " ".join([l[1][0] for l in res_t[0]])
                            clean_t = t_str.replace(" ", "").lstrip("/／\\|lI-_,.")
                            m = re.search(r'(\d+)[:：](\d+)', clean_t)
                            if m: return int(m.group(1)) * 60 + min(int(m.group(2)), 59)
                            t_res = self.op.check_countdown(clean_t)
                            if t_res: return t_res[0]
                            db = re.findall(r'\d+', clean_t)
                            if db:
                                pd = db[-1]
                                if len(pd) > 4: pd = pd[-4:]
                                if len(pd) <= 2: return int(pd)
                                return int(pd[:-2]) * 60 + min(int(pd[-2:]), 59)
                            return -1

                        t1 = extract_time_lite()
                        self.op.delay(1.5)
                        t2 = extract_time_lite()
                        self.op.delay(1.5)
                        t3 = extract_time_lite()

                        times = [t for t in [t1, t2, t3] if t > 0]
                        final_t = -1
                        if len(times) == 0:
                            final_t = -1
                        elif len(times) <= 2:
                            final_t = max(times)
                        else:
                            d12, d23, d13 = abs(times[0] - times[1]), abs(times[1] - times[2]), abs(
                                times[0] - times[2])
                            min_diff = min(d12, d23, d13)
                            if min_diff == d12:
                                final_t = times[1]
                            elif min_diff == d23:
                                final_t = times[2]
                            else:
                                final_t = times[2]

                        # 关闭面板
                        self.op.click_back(self.device_id)
                        self.op.delay(1.2)

                        if final_t <= 0:
                            self.op.delay(30)
                            continue

                        # --- 4. 倒计时分流参与 ---
                        if final_t < 60:
                            self.t_print("提示", f"福袋剩余 {final_t} 秒，刷新坐标直接参与")
                            fudai_info = self._search_fudai_loop()
                            if not fudai_info:
                                continue
                            break

                        elif 60 <= final_t <= 900:
                            safe_max = final_t - 15
                            if safe_max < 60: safe_max = 60
                            wait_sec = random.randint(60, safe_max)
                            self.t_print("等待", f"剩余 {final_t} 秒，随机等待 {wait_sec} 秒")
                            self.op.delay(wait_sec)

                            fudai_info = self._search_fudai_loop()
                            if not fudai_info:
                                continue
                            break

                        else:
                            self.op.delay(30)
                            continue
                else:
                    # 如果不是模式0，直接用原生方法搜寻！
                    fudai_info = self._search_fudai_loop()

            if getattr(self, 'force_switch_flag', False):
                continue

            if fudai_info:
                room_empty_wait = 0
                ftype, pos = fudai_info
                self.last_ftype_memory = ftype
                self.last_fudai_icon_pos = pos
                # ==========================================
                # ★ 激活自学习引擎：记录并固化最高横向轴线
                # ==========================================
                if pos and 'tl' in pos:
                    current_y = pos['tl'][1]
                    cached_y = self.dm.get_coordinate('fudai_min_y')
                    # 如果内存中没有，或者当前福袋位置更高(Y值更小)，就更新结界线！
                    if not cached_y or current_y < cached_y[1]:
                        self.dm.set_coordinate('fudai_min_y', [0, current_y])
                        self.t_print("雷达校准", f"已更新当前设备屏幕天花板结界: Y={current_y}")
                if not is_reloading:
                    self.t_print("视觉", "发现福袋挂件，正在打开详情页确认...")
                    # ★ 新增：每次点开新福袋前，强制清空上一轮的记忆！
                    # 这样即使第2轮奖品和第1轮一模一样，也会重新完整播报！
                    self.last_parsed_prize = ""
                    self.last_parsed_f_id = ""
                    self.global_deadlock_count = 0  # ★ 新增：打开新福袋时清零死锁计数

                # 类型过滤
                is_allowed = True
                if ftype == 'SUPER' and not enable_super:
                    self.t_print("过滤", "配置拒绝超级福袋 -> 跳过")
                    is_allowed = False
                elif ftype == 'NORMAL' and not enable_normal:
                    self.t_print("过滤", "配置拒绝普通福袋 -> 跳过")
                    is_allowed = False
                elif ftype == 'FESTIVAL' and not enable_festival:
                    self.t_print("过滤", "配置拒绝节日福袋 -> 跳过")
                    is_allowed = False

                if not is_allowed:
                    # --- [模式0] 发现不想要的福袋 ---
                    if run_mode == 0:
                        self.t_print("过滤", "固定直播间模式 福袋内容不理想，原地等待 60秒...")
                        self.op.delay(60)
                        self.op.click(device_id, (500, 500))  # 防休眠
                    else:
                        self.t_print("动作", "根据配置切换直播间...")
                        execute_room_switch("BENIGN")
                    continue

                # print(f">>> [锁定] 目标符合配置，准备打开...")
                # ★ 如果刚才检测到面板开着，就绝不点击，直接传给下面的提取舱！
                if panel_already_open:
                    #self.t_print("免开检测", "福袋面板依然开启，跳过点击图标步骤，直接接管解析！", self.C_CYAN, indent=1)
                    pass
                else:
                    self.op.save_debug_image(sc,
                                             (pos['tl'][0], pos['tl'][1], pos['tl'][0] + pos['w'],
                                              pos['tl'][1] + pos['h']),
                                             f"Lock_{ftype}", "07_Lock_Fudai", click_pos=(pos['cx'], pos['cy']))
                    self.op.click(self.device_id, (pos['cx'], pos['cy']))
                    self.op.delay(2.5, 3.5)


                # ==========================================
                # ★ V7.4 终极解耦：金额与黑名单独立控制引擎
                # ==========================================

                content_privilege = False
                effective_min_value = min_prize_value
                is_value_exam_time = False

                # 1. 内容特权 (黑名单豁免权)：仅在午夜狂暴模式开启！
                is_nolimit = False
                if nolimit_start_hour > nolimit_end_hour:
                    is_nolimit = current_time_val >= nolimit_start_hour or current_time_val < nolimit_end_hour
                else:
                    is_nolimit = nolimit_start_hour <= current_time_val < nolimit_end_hour

                if is_nolimit:
                    content_privilege = True
                    effective_min_value = 0
                    if not is_reloading:
                        self.t_print("午夜狂暴", "当前时段特权激活，无视一切价值与黑名单，全部通吃！")

                # 2. 价值门槛 (金额过滤)：动态计算！
                else:
                    if run_mode == 1 and not mode1_strict_value:
                        # 模式1 且 非严苛模式：金额门槛强制降为 0 (绝不因便宜而拦截)
                        effective_min_value = 0
                    elif run_mode == 0 and is_original_room:
                        # 模式0 且 初始死磕房间：金额门槛强制降为 0 (绝不因便宜而拦截)
                        # ★ 新增：驻留时间大考拦截
                        if time.time() >= next_value_check_time:
                            is_value_exam_time = True
                            effective_min_value = min_prize_value  # 蜜月期结束，恢复拦截阈值！
                            self.t_print("价值大考", f"驻留已达设定时间，开启本轮考核 (要求 >= ￥{min_prize_value})")

                        else:
                            effective_min_value = 0

                # ★★★ 新增：模式 0 特权，无视等待时间上限！★★★
                effective_wait_min_super = wait_min_super
                effective_wait_min_normal = wait_min_normal
                if run_mode == 0 and is_original_room:
                    effective_wait_min_super = 999  # 强行拉满到 999 分钟
                    effective_wait_min_normal = 999
                    if not is_reloading:
                        #print(f">>> [特权] 固定直播间模式 死磕状态，无视时间上限，通吃并静默守候！")
                        pass

                # ==========================================
                # ★ 动态路由：侦测三列矩阵变异体 (兼容助力版超级福袋)
                # ==========================================
                if ftype == 'SUPER' and not is_reloading and not panel_already_open:
                    self.op.get_screenshot(self.device_id, silent=True)
                    sc_peek = self.op.cv_imread("pic/screenshot.png")
                    if sc_peek is not None:
                        h_p, w_p = sc_peek.shape[:2]
                        # 偷瞄屏幕中段：起始高度下压到 45% (避开主播画面和福袋标题)，截止于 80% (避开底部按钮)
                        peek_text = self.op.analyse_area_text(sc_peek, (0, int(h_p * 0.45), w_p, int(h_p * 0.80)), "")
                        if ("一等奖" in peek_text and "二等奖" in peek_text) or any(kw in peek_text for kw in ["三等奖", "等奖", "分享助力", "好运翻倍", "限1份"]):
                            # 静默切换为节日引擎
                            ftype = 'FESTIVAL'
                            self.last_ftype_memory = 'FESTIVAL'  # 锁定记忆，防止重载时跳走
                # ==========================================
                # ★ 分流处理并接收状态信号
                # ==========================================
                res_status = None
                if ftype == 'FESTIVAL':
                    # ★ 节日/新年福袋 大一统专属独立引擎！
                    res_status = self.process_festival_fudai(
                        pos=pos,
                        wait_min=effective_wait_min_super, allow_fans=allow_fans_join,
                        allow_diamond=allow_diamond_pay,
                        min_prize_value=effective_min_value, ignore_value_filter=content_privilege,
                        vip_keywords=vip_keywords, is_reloading=is_reloading
                    )
                else:
                    # ★ 精准分流调用，并将统筹好的权限参数传给各自的独立引擎！
                    if ftype == 'NORMAL':
                        res_status = self.process_normal_fudai(
                            effective_wait_min_normal, allow_fans_join, allow_diamond_pay,
                            min_prize_value=effective_min_value, ignore_value_filter=content_privilege,
                            vip_keywords=vip_keywords,  # ★ 把白名单传给普通福袋引擎
                            action_area_height=normal_action_area_height,
                            action_area_box=normal_action_area_box,
                            is_reloading=is_reloading
                        )
                    else:
                        res_status = self.process_normal_super_fudai(
                            ftype, effective_wait_min_super, allow_fans_join, allow_diamond_pay,
                            action_area_height, action_area_box,
                            min_prize_value=effective_min_value,
                            ignore_value_filter=content_privilege,
                            enable_super=enable_super,
                            enable_normal=enable_normal,
                            is_reloading=is_reloading,
                            normal_action_area_height = normal_action_area_height,
                            normal_action_area_box=normal_action_area_box,
                            time_area_box=time_area_box,
                            vip_keywords=vip_keywords
                        )
                # ★★★ 修正缩进：把统一调度向外提了一个层级，让三种福袋都能执行到！ ★★★
                self.op.delay(1, 2)
                current_reloading_state = is_reloading
                is_reloading = False

                # ==========================================
                # ★ 统一状态处理机 (彻底修复 elif 逻辑短路 Bug)
                # ==========================================

                # ★ 独立逻辑：只要不是打不开面板，就清零打不开的计数器
                if res_status != "OPEN_PANEL_FAILED":
                    self.open_fail_count = 0
                    self.hard_clear_count = getattr(self, 'hard_clear_count', 0) * 0  # ★ 只要成功一次，顽固计数器瞬间归零

                # ★ 新增：接管内层引擎发出的“底层物理强杀”信号
                if res_status == "HARD_RESTARTED":
                    self.t_print("主控同步", "收到内层引擎底层重启信号，正在全量重置主循环状态...")
                    self.soft_rescue_history.clear()
                    continuous_overflow_count = 0
                    is_original_room = False
                    fail_count = 0
                    room_switch_count = 0
                    low_value_streak = 0
                    room_fudai_count = 0
                    room_empty_wait = 0
                    is_reloading = False
                    self.just_switched_room = True
                    self.just_switched_room_count = 0
                    self.last_clean_restart_time = time.time()
                    continue  # 此时的 continue 才是真正回到主循环首部！

                # 1. 各种跳过状态
                if res_status in ["SKIP", "SKIP_LOW_VALUE", "SKIP_TIMEOUT"]:
                    if run_mode == 0 and is_original_room:
                        if is_value_exam_time:
                            self.t_print("结束死磕", "目标价值不达标！结束死磕，强行切房！！！")
                            # ★ 修复传参：向裁判所输送真实原因
                            exec_reason = "LOW_VALUE" if res_status == "SKIP_LOW_VALUE" else (
                                "TIMEOUT" if res_status == "SKIP_TIMEOUT" else "BENIGN")
                            execute_room_switch(exec_reason)
                        else:
                            self.t_print("跳过", "固定直播间内目标不可参与或已结束，原地等待 60秒...")
                            self.op.delay(60)
                            self.op.click(device_id, (500, 500))
                    else:
                        if res_status == "SKIP_LOW_VALUE":
                            reason_str = "价值过低"
                            exec_reason = "LOW_VALUE"
                        elif res_status == "SKIP_TIMEOUT":
                            reason_str = "等待时间过长"
                            exec_reason = "TIMEOUT"  # 恶性轨道
                        else:
                            reason_str = "不可参与/已结束/黑名单"
                            exec_reason = "BENIGN"  # ★ 核心修正：黑名单等正常UI交互必须计为良性免死轨道！
                        self.t_print("动作", f"目标不符合要求 ({reason_str})，切换直播间...")
                        execute_room_switch(exec_reason)

                elif res_status == "SKIP_DIAMOND":
                    self.t_print("保护机制", "遇到消费钻石且未授权！强制放弃当前直播间，向上切换！")
                    execute_room_switch("DIAMOND")  # ★ 核心修正：声明良性免死

                elif res_status == "ALREADY_SWIPED":
                    pass

                # 2. 任务执行完毕，准备重载确认
                elif res_status == "TASK_DONE":
                    self.global_deadlock_count = getattr(self, 'global_deadlock_count', 0) + 1
                    if self.global_deadlock_count >= 5:
                        self.t_print("风控拦截", "连续 5 次尝试任务无反应或面板异常！判定被限，强制切房！", self.C_RED)
                        execute_room_switch()
                        continue

                    is_reloading = True
                    self.op.delay(2)

                # 3. 遭遇流氓弹窗（如1元购物券）的“破壁”清场机制
                elif res_status in ["OPEN_PANEL_FAILED", "OPEN_PANEL_FAILED_RELOAD"]:
                    if res_status == "OPEN_PANEL_FAILED_RELOAD":
                        current_reloading_state = True  # ★ 核心修复：接收到特殊信号，强制同步内部的重载记忆！

                    self.open_fail_count = getattr(self, 'open_fail_count', 0) + 1

                    if self.open_fail_count >= 3:
                        # ★ 新增：顽固弹窗计数器
                        self.hard_clear_count = getattr(self, 'hard_clear_count', 0) + 1

                        if self.hard_clear_count >= 3:
                            self.t_print("终极清场", "连续 3 次物理返回无效！遭遇流氓霸屏弹窗，执行柔性击杀重启！",
                                         self.C_RED)

                            # 1. 强制 Home 键回桌面 (无视任何 App 的拦截)
                            self.op.adb_key_event(self.device_id, 3)
                            self.op.delay(2.0)

                            # 2. 物理级强杀后台 (彻底销毁进程与流氓弹窗)
                            subprocess.run(f"adb -s {self.device_id} shell am force-stop com.ss.android.ugc.aweme",
                                           shell=True, stdout=subprocess.DEVNULL)
                            self.op.delay(2.0)

                            # 3. 重新启动 App
                            self.op.start_app(self.device_id)
                            self.t_print("终极清场", "抖音已重新拉起，等待加载并重新寻路...")
                            self.op.delay(10.0)

                            # 4. 根据当前模式，重新寻路进房
                            if run_mode == 1:
                                self.nav.enter_following_live(self.device_id)
                            elif run_mode == 2:
                                self.nav.enter_live_square(self.device_id)
                            elif run_mode == 3:
                                self.nav.enter_search_live(self.device_id, search_kw)

                            # 5. 重置所有相关状态，开启崭新循环
                            self.open_fail_count = 0
                            self.hard_clear_count = 0
                            is_reloading = False
                            is_original_room = False
                            fail_count = 0
                            room_switch_count = 0
                            low_value_streak = 0
                            self.just_switched_room = True  # 赋予免检特权
                            self.just_switched_room_count = 0

                            # ==========================================
                            # ★ 核心补充：补齐所有的全局抗卡死计数器清零
                            # ==========================================
                            self.soft_rescue_history.clear()
                            continuous_overflow_count = 0
                            room_fudai_count = 0
                            room_empty_wait = 0
                            self.last_clean_restart_time = time.time()

                            # ★ 终极修复：绝对不能用 return！必须用 continue 回到主循环首部！
                            continue

                        else:
                            # 还没到 3 次，继续尝试普通的物理返回
                            self.t_print("清场拦截",
                                         f"连续 {self.open_fail_count} 次无法打开面板！执行物理返回清场... (顽固警告: {self.hard_clear_count}/3)")
                            # ==========================================
                            # ★ 流氓弹窗视觉击杀舱前置拦截
                            # ==========================================
                            is_cleaned = self._kill_rogue_popup_loop()

                            if not is_cleaned:
                                self.t_print("兜底强杀", "视觉隔离舱清理无果，触发系统物理返回键清场", self.C_YELLOW,
                                             indent=1)
                                self.op.adb_key_event(self.device_id, 4)
                                self.op.delay(2.5)

                            self.open_fail_count = 0
                            is_reloading = current_reloading_state  # ★ 核心：继承并恢复重载身份！
                    else:
                        is_reloading = current_reloading_state
                        if res_status == "OPEN_PANEL_FAILED_RELOAD":
                            self.op.delay(0.5)
                        else:
                            self.op.delay(2.5)

                # ==========================================
                # ★ 新增：时光倒流/提前苏醒 纠错防线 (完全按照你的构想)
                # ==========================================
                elif res_status == "EARLY_WAKEUP":
                    self.t_print("时空回溯", "捕获到提前苏醒信号！倒计时存在误差，重新读取真实时间...")
                    # 防鬼畜/死循环缓冲护盾 (非常重要，防止因为卡顿一直错一直点，引发抖音风控)
                    self.op.delay(5.0, 8.0)

                    # ★ 核心操作 1：彻底重置重载状态，让引擎把它当做新福袋去全量提取时间和奖品！
                    is_reloading = False

