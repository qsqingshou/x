    def _check_content_filter(self, text):
        for w in self.not_want_list:
            if w in text:
                print(f">>> [过滤] 不想要: {w}")
                return True
        return False

    # ==========================================
    # ★ 新引擎组件：福袋身份模糊去重器 (极简静默版)
    # ==========================================
    def _is_same_fudai_prize(self, name1, name2, threshold=0.75):
        """后台静默对比两个奖品名是否属于同一福袋，免疫 OCR 漏字错字"""
        if not name1 or not name2:
            return False

        # 完美正则：字符集内无需转义括号，保留中英文括号、汉字、字母和数字
        clean_n1 = re.sub(r'[^\w\u4e00-\u9fa5()（）]', '', str(name1)).lower()
        clean_n2 = re.sub(r'[^\w\u4e00-\u9fa5()（）]', '', str(name2)).lower()

        # 轨道 1：互相包含直接放行 (应对 OCR 严重截断)
        if clean_n1 in clean_n2 or clean_n2 in clean_n1:
            return True

        # 轨道 2：计算莱文斯坦相似度 (应对 OCR 错别字)
        similarity = difflib.SequenceMatcher(None, clean_n1, clean_n2).ratio()
        if similarity >= threshold:
            return True

        return False

    def _process_new_super_fudai_engine(self, sc, anchor, wait_min, allow_fans, allow_diamond, min_prize_value,
                                        ignore_value_filter, is_reloading):
        """
        [新版超级福袋纯净解析舱] (V10 指纹盲滑多福袋遍历版)
        """
        h, w = sc.shape[:2]

        # ==========================================
        # ★ 新增：多福袋状态池与指纹记忆
        # ==========================================
        wait_time_pool = []
        visited_prizes = set()
        fudai_count = 0
        diamond_skipped = False
        time_skipped = False
        near_death_skipped = False  # ★ 修复地雷：提前声明濒死跳过标记！

        # ★ 开启卡片遍历大循环
        while True:
            # 除第一次外，每次循环重新获取最新画面（支持滑动后的新卡片）
            if fudai_count > 0:
                self.op.get_screenshot(self.device_id, silent=True)
                sc = self.op.cv_imread("pic/screenshot.png")
                if sc is None: break

            fudai_count += 1
            current_f_id = f"福袋_{fudai_count}"

            roi = sc[int(h * 0.3):h, 0:w]
            ocr_res = self.op.ocr.ocr(roi, cls=False)
            if not ocr_res or not ocr_res[0]:
                break

            y_offset = int(h * 0.3)

            # ==========================================
            # ★ 阶段一：确立绝对物理天花板 (双轨扫描法)
            # ==========================================
            y_time = 0
            y_task = h
            y_header_end = 0
            # ★ 新增：动态地板与左侧围栏的探测锚点
            y_0yuan = h
            x_0yuan = 0
            y_value = h
            x_value = 0

            # 【第一轨】：寻找面板头部的标志性词汇，确立绝对的 Y 轴天花板
            for line in ocr_res[0]:
                text = line[1][0]
                cy = (line[0][0][1] + line[0][2][1]) / 2 + y_offset

                # 听你的：紧挨着的“超级福袋”和“任务抽取/完成任务”，以此作为最高结界！
                if any(kw in text for kw in ["超级福袋", "任务抽取", "完成任务"]):
                    if cy > y_header_end:
                        y_header_end = cy

            # 极端兜底：如果这几个字没被扫出来，给一个安全的默认结界
            if y_header_end == 0:
                y_header_end = int(h * 0.3)

            # 【第二轨】：在天花板下方寻找真正的有效数据！
            clean_text_list = []
            for line in ocr_res[0]:
                text = line[1][0]
                cy = (line[0][0][1] + line[0][2][1]) / 2 + y_offset

                # ★ 核心护盾：所有的提取动作，必须在天花板之下进行！物理屏蔽背景挂件！
                if cy > y_header_end:
                    clean_text_list.append(text)

                    # 寻找倒计时 Y 轴（只要在结界下方，第一眼看到冒号就绝对是真倒计时）
                    if (
                            "后开奖" in text or "后开" in text or "/" in text or "／" in text or ":" in text or "：" in text) and any(
                            c.isdigit() for c in text):
                        if y_time == 0:
                            y_time = cy

                    # ★ 动态地板探测：优先级 1 (0元带走)
                    if "0元带走" in text:
                        if cy < y_0yuan:
                            y_0yuan = cy
                            x_0yuan = line[0][0][0]  # 同步记录左侧 X 坐标作为围栏
                    # ★ 动态地板探测：优先级 2 (参考价/价值/￥)
                    elif any(kw in text for kw in ["参考价", "价值", "￥", "¥"]):
                        if cy < y_value:
                            y_value = cy
                        # ★ 核心修正：只有在文本包含符号时，才允许提取它的 X 坐标作为围栏！
                        if any(kw in text for kw in ["￥", "¥"]):
                            if x_value == 0 or line[0][0][0] < x_value:
                                x_value = line[0][0][0]
                    # ★ 动态地板探测：兜底 (底部的任务说明区)

                    # 寻找底部任务区天花板
                    elif "福袋任务" in text or "任务已完成" in text:
                        if cy < y_task:
                            y_task = cy

            full_text_debug = "".join(clean_text_list)

            # ==========================================
            # ★ 动态计算绝对安全的滑动区域 (防任务列表滚动死区)
            # 顶部边界：已参与/后开奖的底部
            # 底部边界：最底部悬浮按钮的顶部
            # ==========================================
            safe_top = max(y_header_end, y_time)
            if safe_top == 0: safe_top = int(h * 0.5)  # 极小概率的兜底

            safe_bottom = h
            for line in ocr_res[0]:
                cy = (line[0][0][1] + line[0][2][1]) / 2 + y_offset
                text = line[1][0]
                # 侦测底部的固定动作按钮，锁定其最高点作为底部边界
                if cy > h * 0.6 and any(kw in text for kw in
                                        ["加入", "粉丝团", "评论", "观看", "开通", "抽奖", "不满足", "下次", "等待开奖",
                                         "参与成功", "已参与", "钻石", "1钻"]):
                    if cy < safe_bottom:
                        safe_bottom = cy

            if safe_bottom == h: safe_bottom = int(h * 0.85)  # 没找到按钮时的兜底

            # ★ 锁定真正的滑动缝隙中心！这个 Y 坐标将在后续所有滑动中使用！
            swipe_y = int((safe_top + safe_bottom) / 2)

            # --- 阶段二：时间提取 ---
            fudai_total_seconds = 0
            if y_time > 0:
                time_lines = []
                y_tolerance = self.dm.scale(30)
                for line in ocr_res[0]:
                    cy = (line[0][0][1] + line[0][2][1]) / 2 + y_offset
                    # ★ 补漏：收集时间碎片时，也必须严格遵守天花板结界！
                    if abs(cy - y_time) < y_tolerance and cy > y_header_end:
                        time_lines.append(line)

                time_lines = sorted(time_lines, key=lambda x: x[0][0][0])
                time_str = " ".join([l[1][0] for l in time_lines])

                # 新增：极简提取倒计时物理扫描带，直观查看提取范围是否产生Y轴截断
                crop_y1 = max(int(y_header_end), int(y_time - y_tolerance))
                crop_y2 = min(h, int(y_time + y_tolerance))
                if crop_y2 > crop_y1:
                    self.op.cv_imwrite("pic/time_crop.png", sc[crop_y1:crop_y2, 0:w])

                # ==========================================
                # ★ 核心修复：整体词汇向心定界提取 (极简、绝对稳定)
                # ==========================================
                clean_time_str = time_str

                # 1. 左侧定界：使用完整词汇斩断人数污染
                for kw in ["人已参与", "人 已参与", "已参与"]:
                    if kw in clean_time_str:
                        clean_time_str = clean_time_str.split(kw)[-1]
                        break

                # 2. 右侧定界：使用完整词汇斩断后缀干扰
                if "后开奖" in clean_time_str:
                    clean_time_str = clean_time_str.split("后开奖")[0]

                # 3. 内部清理与防异变滤渣
                # ★ 核心防线：绝对不删空格！利用空格作为物理阻断墙
                # 清理切割后左侧可能残留的斜杠及 OCR 异变符号，确保数字纯净
                clean_time_str = clean_time_str.lstrip("/／\\|lI-_,.")

                # 阶梯 1：精准狙击冒号 (天然免疫被空格隔开的干扰字符)
                # 例如 "1 11:56" 会被精准提取出 "11:56"，前方的 "1 " 被完美物理隔离
                match_colon = re.search(r'(\d+)[:：](\d+)', clean_time_str)

                if match_colon:
                    minutes = int(match_colon.group(1))
                    seconds = int(match_colon.group(2))
                    if seconds >= 60: seconds = 59
                    fudai_total_seconds = minutes * 60 + seconds
                else:
                    t_res = self.op.check_countdown(clean_time_str)
                    if t_res:
                        fudai_total_seconds = t_res[0]
                    else:
                        # 阶梯 2：纯数字兜底 (带空格物理隔离版)
                        # 利用 re.findall 提取所有被空格或非数字隔开的数字块，只取最后一块！
                        # 例如 "1 1156" -> ["1", "1156"] -> 完美锁定 "1156"
                        digit_blocks = re.findall(r'\d+', clean_time_str)
                        if digit_blocks:
                            pure_digits = digit_blocks[-1]
                            if len(pure_digits) > 4:
                                pure_digits = pure_digits[-4:]

                            if len(pure_digits) <= 2:
                                fudai_total_seconds = int(pure_digits)
                            else:
                                minutes = int(pure_digits[:-2])
                                seconds = int(pure_digits[-2:])
                                if seconds >= 60: seconds = 59
                                fudai_total_seconds = minutes * 60 + seconds
            # ==========================================
            # ★ 修复 1：时间“未知”重试补获机制
            # ==========================================
            if fudai_total_seconds == 0:
                self.t_print("时间补获", f"{current_f_id} 未提取到有效倒计时，正在重新扫描...", indent=1)
                self.op.delay(1.0)  # 停顿1秒，等UI彻底稳定
                self.op.get_screenshot(self.device_id, silent=True)
                sc_retry = self.op.cv_imread("pic/screenshot.png")
                if sc_retry is not None:
                    ocr_retry = self.op.ocr.ocr(sc_retry[int(h * 0.3):h, 0:w], cls=False)
                    if ocr_retry and ocr_retry[0]:
                        for line in ocr_retry[0]:
                            text = line[1][0]
                            if ("后开" in text or ":" in text or "：" in text) and any(
                                    c.isdigit() for c in text):
                                # ★ 核心防线：不删空格！
                                clean_t = text.lstrip("/／\\|lI-_,.")
                                m = re.search(r'(\d+)[:：](\d+)', clean_t)
                                if m:
                                    fudai_total_seconds = int(m.group(1)) * 60 + min(int(m.group(2)), 59)
                                    break
                                # 纯数字兜底：找最后一个连续数字块，避免被前方的孤立数字污染
                                digit_blocks = re.findall(r'\d+', clean_t)
                                if digit_blocks:
                                    pure_digits = digit_blocks[-1]
                                    if len(pure_digits) > 4: pure_digits = pure_digits[-4:]
                                    if len(pure_digits) <= 2:
                                        fudai_total_seconds = int(pure_digits)
                                    else:
                                        fudai_total_seconds = int(pure_digits[:-2]) * 60 + min(int(pure_digits[-2:]),
                                                                                               59)
                                    break
                if fudai_total_seconds > 0:
                    self.t_print("时间补获",
                                 f"{current_f_id} 重新提取到剩余时间: {fudai_total_seconds // 60}分{fudai_total_seconds % 60}秒",
                                 indent=1)
                else:
                    # ==========================================
                    # ★ 核心修复：濒死福袋智能推算引擎
                    # 避免任务耗时过长导致时间提取失败被误塞 90 秒假情报！
                    # ==========================================
                    is_deduced_dead = False
                    if is_reloading and hasattr(self, 'fudai_time_cache') and current_f_id in self.fudai_time_cache:
                        expected_end_time = self.fudai_time_cache[current_f_id]
                        # 允许 5 秒的误差（推算如果现在离原本开奖时间不到 5 秒，说明肯定已经开了）
                        if time.time() >= expected_end_time - 5:
                            is_deduced_dead = True

                    if is_deduced_dead:
                        self.t_print("时间推算", f"{current_f_id} 根据T1记忆推算已开奖，放弃90秒兜底，直达结算！",
                                     indent=1)
                        fudai_total_seconds = 0
                    else:
                        self.t_print("时间补获", f"{current_f_id} 重新扫描仍未提取到时间，设为兜底时间 90秒", indent=1)
                        fudai_total_seconds = 90

            # ==========================================
            # ★ 阶段 2.5：自然流速比对网关 (跨周期解耦版)
            # ==========================================
            is_new_fudai = False

            if current_f_id not in self.fudai_time_cache:
                is_new_fudai = True
            else:
                # 提取历史锚点进行预判
                expected_end_time = self.fudai_time_cache[current_f_id]
                natural_flow_time = max(0, int(expected_end_time - time.time()))

                # ★ 核心修复：如果前世记忆已经归零，或者屏幕上的时间远大于原子钟，
                # 说明这绝对是同一直播间新发的同名福袋，强制刷新记忆！
                if natural_flow_time == 0 or fudai_total_seconds > natural_flow_time + 60:
                    is_new_fudai = True

            if is_new_fudai:
                # 【T1阶段】初次见面，或跨周期的新福袋，写入绝对锚点
                if fudai_total_seconds > 0:
                    self.fudai_time_cache[current_f_id] = time.time() + fudai_total_seconds
            else:
                # 【T2阶段】同一生命周期内的重载复核，利用锚点进行纠错
                expected_end_time = self.fudai_time_cache[current_f_id]
                natural_flow_time = max(0, int(expected_end_time - time.time()))

                # 误差超过 10 秒（说明提取仓漏读或UI冻结），强制用原子钟接管
                if abs(fudai_total_seconds - natural_flow_time) > 10:
                    fudai_total_seconds = natural_flow_time

            # --- 阶段三：奖品区提取 ---
            # ★ 1. 强制保底初始化，彻底消灭 NameError 报错风险
            prize_texts = []
            ref_num = 0
            prize_name = ""

            # ★ 2. 划定绝对的三维物理坐标边界
            y_prize_top = max(y_header_end, y_time) + self.dm.scale(20)  # 天花板

            # 动态严苛地板（专门用来卡奖品名的，把 0元带走 和 价值行 挡在结界外）
            y_prize_bottom = y_task
            if y_0yuan < h:
                y_prize_bottom = y_0yuan
            elif y_value < h:
                y_prize_bottom = y_value

            # 左侧围栏（如果有钞票符号，则用符号坐标；否则默认 35%）
            x_prize_left = int(w * 0.35)
            if x_0yuan > 0:
                x_prize_left = x_0yuan
            elif x_value > 0:
                x_prize_left = x_value

            # ★ 3. 遍历提取 (双通道互不干扰)
            for line in ocr_res[0]:
                text = line[1][0]
                box = line[0]
                cx = (box[0][0] + box[2][0]) / 2
                cy = (box[0][1] + box[2][1]) / 2 + y_offset

                # 如果越过左侧围栏，才进行处理
                if cx > x_prize_left - self.dm.scale(30):

                    # 【通道一：只管提取价值】 (使用宽容的 y_task 作为地板，确保价值行能进入)
                    if y_prize_top < cy < y_task:
                        # 条件：包含价值/钞票标志，且绝对不能包含"0元带走"！
                        if any(kw in text for kw in ["参考价", "价值", "￥", "¥"]) and "0元带走" not in text:
                            nums = re.findall(r'(?:[￥¥]|价值|参考价)[:：\s]*(\d+\.?\d*)', text)
                            if nums:
                                temp_num = float(nums[-1])
                                ref_num = int(temp_num) if temp_num.is_integer() else temp_num

                    # 【通道二：纯物理截取奖品】 (使用严苛的 y_prize_bottom 结界)
                    # 只要是在动态地板上方的文字，统统视为奖品内容！
                    if y_prize_top < cy < y_prize_bottom:
                        # 顺手过滤掉可能误入的天花板残渣，剩下的原模原样收录
                        if not any(kw in text for kw in ["超级福袋", "任务抽取", "人参与", "后开奖"]):
                            prize_texts.append(text)

            # 拼装最终结果
            prize_name = "".join(prize_texts)

            # 将超级福袋的奖品名称写入全局记忆体，供开奖时直接盲提！
            if prize_name and not is_reloading:
                self.last_parsed_prize = prize_name
                self.last_parsed_value = ref_num  # 补全价值记忆

                # [架构升级] 屏蔽单体污染，将超级福袋信息绑定绝对开奖时间戳！
                expected_timestamp = time.time() + fudai_total_seconds
                self.multi_prize_memory[expected_timestamp] = {
                    'prize': prize_name,
                    'value': ref_num
                }

            # ==========================================
            # ★ 破局核心：指纹去重探测 (物理防撞墙机制 - 模糊匹配版)
            # ==========================================
            is_duplicate = False
            if prize_name:
                for existing_prize in visited_prizes:
                    # 避开兜底名称，只对真实的奖品名称进行模糊相似度比对
                    if not existing_prize.startswith("未知奖品_") and self._is_same_fudai_prize(existing_prize,
                                                                                                prize_name):
                        is_duplicate = True
                        break
            else:
                # ★ 核心修复：没扫出名字时，允许 30 秒的倒计时自然流逝误差，绝对防止死循环！
                for existing_prize in visited_prizes:
                    if existing_prize.startswith("未知奖品_"):
                        try:
                            old_seconds = int(existing_prize.split("_")[1])
                            # 如果时间差在 30 秒内，物理上绝对是刚才滑过去的同一个福袋
                            if abs(old_seconds - fudai_total_seconds) < 30:
                                is_duplicate = True
                                break
                        except:
                            pass
                if not is_duplicate:
                    fingerprint = f"未知奖品_{fudai_total_seconds}"
                    if fingerprint in visited_prizes:
                        is_duplicate = True

            if is_duplicate:
                # ★ 绝对静默：如果发现重复（即向左盲滑到底，页面回弹了），直接跳出大循环，不输出任何啰嗦日志！
                break

            # 确认是新福袋，将其加入已访问的记忆池
            if prize_name:
                visited_prizes.add(prize_name)
            else:
                visited_prizes.add(f"未知奖品_{fudai_total_seconds}")

            final_time = f"{fudai_total_seconds // 60}分{fudai_total_seconds % 60}秒" if fudai_total_seconds > 0 else "未知"

            if not is_reloading:
                self.t_print("内容", f"【{current_f_id}】 奖品: {prize_name} | 剩余: {final_time} | 价值：￥{ref_num}",
                             self.C_GREEN, indent=1)
            else:
                self.t_print("状态更新", f"{current_f_id} 正在确认开奖状态 | 剩余时间: {final_time}", indent=1)

            # --- 白名单与价值拦截逻辑 ---
            has_privilege = False
            has_luxury_privilege = False

            for kw in self.want_list:
                if kw and kw in prize_name:
                    has_privilege = True
                    if not is_reloading: self.t_print("特权激活",
                                                      f"【{current_f_id}】匹配到全局白名单奖品 '{kw}'，强行咬住！")
                    break

            for kw in getattr(self, 'luxury_list', []):
                if kw and kw in prize_name:
                    has_privilege = True
                    has_luxury_privilege = True
                    if not is_reloading: self.t_print("豪华特权激活",
                                                      f"【{current_f_id}】匹配到顶级豪华奖品 '{kw}'，无视金额与时间死磕到底！")
                    break

            skip_this_card = False
            if not is_reloading:
                if not ignore_value_filter:
                    # ★ 核心修复：只信任从物理结界里提出来的纯净 prize_name，绝不能加上 full_text_debug 导致任务区文字污染！
                    if self._check_content_filter(prize_name):
                        self.t_print("过滤", f"【{current_f_id}】包含黑名单奖品，跳过该卡片！")
                        skip_this_card = True
                    elif not has_privilege and min_prize_value > 0 and 0 < ref_num < min_prize_value:
                        self.t_print("价值拦截", f"【{current_f_id}】价值 ￥{ref_num} 低于阈值，跳过该卡片！")
                        skip_this_card = True

                if not skip_this_card:
                    if fudai_total_seconds > wait_min * 60:
                        if has_luxury_privilege:
                            self.t_print("豪华死磕",
                                         f"【{current_f_id}】倒计时 {fudai_total_seconds}s 超过限制，但触发豪华特权，无视时间死磕！")
                        else:
                            self.t_print("超时跳过",
                                         f"【{current_f_id}】时间过长 ({fudai_total_seconds}s > {wait_min * 60}s)，跳过该卡片！")
                            time_skipped = True
                            skip_this_card = True
                    elif 0 < fudai_total_seconds < 15:
                        # ★ 核心修复：如果是已参与状态，绝对不放弃！让它流转到下方的入池逻辑
                        if not any(
                                kw in full_text_debug for kw in ["参与成功", "等待开奖", "还需看播", "请勿离开直播间", "否则会失去"]):
                            self.t_print("极限跳过",
                                         f"【{current_f_id}】剩余时间极少({fudai_total_seconds}s)放弃参与！就地休眠等待下一波...", indent=1)
                            near_death_skipped = True
                            skip_this_card = True

            # 如果当前卡片被跳过，直接进行盲滑探测
            if skip_this_card:
                if len(visited_prizes) > 1: self.t_print("多福袋", "尝试向左滑动探测下一个福袋卡片...")
                self.op.swipe_custom(self.device_id, int(w * 0.9), swipe_y, int(w * 0.1), swipe_y, duration=300)
                self.op.delay(2.5)
                continue

            # --- 阶段四：动作区与状态判定 ---
            is_finished = False
            if "请勿离开直播间" in full_text_debug:
                is_finished = True

            if is_finished:
                self.t_print("状态", f"{current_f_id} 成功进入挂机池", indent=1)
                wait_time_pool.append(time.time() + fudai_total_seconds)
                if len(visited_prizes) > 1: self.t_print("多福袋", "尝试向左滑动探测下一个福袋卡片...")
                self.op.swipe_custom(self.device_id, int(w * 0.9), swipe_y, int(w * 0.1), swipe_y, duration=300)
                self.op.delay(2.5)
                continue

            target_btn = None
            btn_text = ""
            action_lines = []

            # ==========================================
            # ★ 动态天花板算法 (听你的：以任务状态底线为界)
            # ==========================================
            search_start_y = max(y_header_end, y_time) + self.dm.scale(50)
            y_task_ceiling = search_start_y

            # 1. 扫描寻找最靠下的任务状态，确立天花板边界
            for line in ocr_res[0]:
                cy = (line[0][0][1] + line[0][2][1]) / 2 + y_offset
                text = line[1][0]
                if cy > search_start_y:
                    # 包含你说的已达标/未达标
                    if any(kw in text for kw in ["已达成", "未达成"]):
                        if cy > y_task_ceiling:
                            y_task_ceiling = cy

            # 2. 收集天花板下方的真正按钮区域文本
            for line in ocr_res[0]:
                cy = (line[0][0][1] + line[0][2][1]) / 2 + y_offset
                # 只要在这个天花板下面 (加一点点间隙防误触)，就全都是按钮！
                if cy > y_task_ceiling + self.dm.scale(15):
                    action_lines.append(line)

            # 3. 极端情况兜底：如果上面没框出任何东西(比如压根没任务列表)，退回大范围物理雷达
            if not action_lines:
                temp_lines = []
                for line in ocr_res[0]:
                    cy = (line[0][0][1] + line[0][2][1]) / 2 + y_offset
                    if cy > search_start_y:
                        temp_lines.append(line)
                if temp_lines:
                    temp_lines = sorted(temp_lines, key=lambda x: x[0][2][1], reverse=True)
                    lowest_y = temp_lines[0][0][2][1]
                    for line in temp_lines:
                        # 听你的，放宽到 250 像素，确保无论屏幕多大都能罩住
                        if lowest_y - line[0][2][1] > self.dm.scale(250):
                            break
                        action_lines.append(line)

            if action_lines:
                action_lines = sorted(action_lines, key=lambda x: x[0][2][1], reverse=True) # 确保第一个遍历到的，绝对是屏幕最底部的真正按钮！
                for line in action_lines:
                    text = line[1][0]
                    # ★ 完美继承旧引擎的底部确权金牌！
                    if any(kw in text for kw in ["参与成功", "等待开奖", "还需看播", "请勿离开直播间", "否则会失去"]):
                        self.t_print("状态", f"{current_f_id} 成功进入挂机池", indent=1)
                        is_finished = True
                        break

                    if any(kw in text for kw in
                           ["加入粉丝团", "购物粉丝团", "直播粉丝团", "粉丝团", "钻石", "1钻", "l钻",
                            "发送评论", "一键发表评论", "发表评论", "键发表",
                            "参与抽奖", "开始观看", "始观看", "观看直播",
                            "开通店铺会员", "店铺会员",
                            "不满足", "暂不满足", "无法参与", "下次福袋等你", "时间不足"]):
                        target_btn = line
                        btn_text = text
                        break

            if is_finished:
                wait_time_pool.append(time.time() + fudai_total_seconds)
                if len(visited_prizes) > 1: self.t_print("多福袋", "尝试向左滑动探测下一个福袋卡片...")
                self.op.swipe_custom(self.device_id, int(w * 0.9), swipe_y, int(w * 0.1), swipe_y, duration=300)
                self.op.delay(2.5)
                continue

            if not target_btn:
                self.t_print("未知", f"{current_f_id} 未发现有效底部按钮，跳过", indent=1)
                if len(visited_prizes) > 1: self.t_print("多福袋", "尝试向左滑动探测下一个福袋卡片...")
                self.op.swipe_custom(self.device_id, int(w * 0.9), swipe_y, int(w * 0.1), swipe_y, duration=300)
                self.op.delay(2.5)
                continue

            # --- 阶段五：执行动作 ---
            box = target_btn[0]
            w_btn = box[2][0] - box[0][0]
            h_btn = box[2][1] - box[0][1]
            cx = int(box[0][0]) + int(w_btn / 2)
            cy = int(box[0][1]) + int(h_btn / 2) + y_offset

            if any(kw in btn_text for kw in ["发送评论", "一键发表评论", "发表评论", "键发表"]):
                self.t_print("动作", f"{current_f_id} 一键评论任务", indent=1)
                self.t_print("面状仿生", f"锁定区域 “{btn_text}” -> 随机落点坐标 ({cx}, {cy})", indent=2)
                self.op.click(self.device_id, (cx, cy))
                self.op.delay(2.5)
                self.op.adb_key_event(self.device_id, 66)
                return "TASK_DONE"

            elif any(kw in btn_text for kw in ["粉丝团", "钻石", "1钻", "l钻"]):
                # ==========================================
                # ★ 严格分支 1：直播粉丝团 / 1钻 (付费扣钻逻辑)
                # ==========================================
                if any(kw in btn_text for kw in ["钻石", "1钻", "l钻", "直播粉丝团"]):
                    if not allow_diamond:
                        self.t_print("钱包保护", f"{current_f_id} 需要消费钻石，配置未允许支付，拒绝执行！", self.C_RED,
                                     indent=1)
                        diamond_skipped = True
                        if len(visited_prizes) > 1: self.t_print("多福袋", "尝试向左滑动探测下一个福袋卡片...")
                        self.op.swipe_custom(self.device_id, int(w * 0.9), swipe_y, int(w * 0.1), swipe_y, duration=300)
                        self.op.delay(2.5)
                        continue

                    self.t_print("动作", f"{current_f_id} 步骤1：点击福袋面板 '{btn_text}'...", indent=1)
                    self.t_print("面状仿生", f"锁定区域 “{btn_text}” -> 随机落点坐标 ({cx}, {cy})", indent=2)
                    self.op.click(self.device_id, (cx, cy))
                    self.op.delay(2.5, 3.5)

                    # --- 100% 移植旧版 1钻 弹窗防御逻辑 ---
                    self.op.get_screenshot(self.device_id, silent=True)
                    sc_pay = self.op.cv_imread("pic/screenshot.png")

                    if sc_pay is not None:
                        pay_res = self.op.ocr.ocr(sc_pay, cls=False)
                        pay_text = "".join([line[1][0] for line in pay_res[0]]) if pay_res and pay_res[0] else ""
                        if any(kw in pay_text for kw in ["充值", "余额", "微信支付", "支付1元", "抖音充值", "充钻石"]):
                            self.t_print("拦截", "钻石/抖币余额不足，触发充值页面！放弃任务...", self.C_YELLOW, indent=1)
                            self.op.click_back(self.device_id)
                            self.op.delay(1.5)
                            return "SKIP"

                        else:
                            # 支付确认弹窗 (兼容旧版与新增的 "确认后不再提醒")
                            if any(kw in pay_text for kw in ["确认并不再提醒", "确认后不再提醒", "不再提醒"]):
                                self.t_print("动作", f"{current_f_id} 步骤2：点击 '确认不再提醒'...", indent=1)
                                self._click_ocr_button(sc_pay, pay_res,
                                                       ["确认并不再提醒", "确认后不再提醒", "不再提醒"], 0,
                                                       debug_name="Click_Pay_Confirm")
                                self.op.delay(2.5, 3.5)

                                # 再次防范点击确认后跳出余额不足页面
                                self.op.get_screenshot(self.device_id, silent=True)
                                sc_pay2 = self.op.cv_imread("pic/screenshot.png")
                                if sc_pay2 is not None:
                                    pay_res2 = self.op.ocr.ocr(sc_pay2, cls=False)
                                    pay_text2 = "".join([line[1][0] for line in pay_res2[0]]) if pay_res2 and pay_res2[
                                        0] else ""
                                    if any(kw in pay_text2 for kw in ["充值", "余额", "微信支付"]):
                                        self.t_print("拦截", "确认支付后余额不足，放弃任务...", self.C_YELLOW, indent=1)
                                        self.op.click_back(self.device_id)
                                        self.op.delay(1.5)
                                        return "SKIP"
                    self.op.click_back(self.device_id)
                    return "TASK_DONE"

                # ==========================================
                # ★ 严格分支 2：购物粉丝团 / 粉丝团 (免费逻辑)
                # ==========================================
                else:
                    if not allow_fans:
                        self.t_print("拦截", "未开启加粉丝团权限，跳过", indent=1)
                        if len(visited_prizes) > 1: self.t_print("多福袋", "尝试向左滑动探测下一个福袋卡片...")
                        self.op.swipe_custom(self.device_id, int(w * 0.9), swipe_y, int(w * 0.1), swipe_y, duration=300)
                        self.op.delay(2.5)
                        continue

                    self.t_print("动作", f"{current_f_id} 步骤1：点击福袋面板 '{btn_text}'...", indent=1)
                    self.t_print("面状仿生", f"锁定区域 “{btn_text}” -> 随机落点坐标 ({cx}, {cy})", indent=2)
                    self.op.click(self.device_id, (cx, cy))
                    self.op.delay(2.5, 3.5)

                    # --- 100% 移植旧版 免费粉丝团 确认逻辑 ---
                    self.op.get_screenshot(self.device_id, silent=True)
                    sc_fans = self.op.cv_imread("pic/screenshot.png")
                    if sc_fans is not None:
                        # ★ 核心防线：切除屏幕上半部，防止扫到底层的任务描述文字导致误触！
                        y_crop = int(h * 0.3)
                        fans_res = self.op.ocr.ocr(sc_fans[y_crop:h, 0:w], cls=False)
                        if fans_res and fans_res[0]:
                            clean_fans_res = []
                            for line in fans_res[0]:
                                # 强力过滤掉底部那行干扰小字
                                if "同步关注" not in line[1][0] and "并关注" not in line[1][0] and "并送" not in \
                                        line[1][0]:
                                    clean_fans_res.append(line)
                            if clean_fans_res:
                                # 只有真正扫到了底部的确认按钮，才会去点击
                                self._click_ocr_button(sc_fans, [clean_fans_res],
                                                       ["加入购物粉丝团", "加入粉丝团", "粉丝团"], y_crop,
                                                       exact_match=False, debug_name="Click_Fans_2")
                                self.op.delay(2.0, 3.0)

