                    # ★ 新增：遇到该任务，直接赋予 SKIP 信号并打印避让日志
                    self.t_print("技术壁垒", f"{current_f_id} 遇到【店铺会员】任务，临时避让并切换直播间！", self.C_YELLOW,
                                 indent=1)
                    status = "SKIP"

                    #self.t_print("动作", f"{current_f_id} 步骤1：点击开通会员...", indent=1)
                    #btn_clicked = self._click_ocr_button(sc, [active_lines], ["去开通店铺会员", "开通店铺", "通店铺会员"],
                    #                                     y_start, debug_name="Click_Member_1")
                    #if not btn_clicked:
                    #    status = "SKIP"
                    #else:
                    #    self.op.delay(2.5, 3.7)
                    #    self.op.get_screenshot(self.device_id, silent=True)
                    #    sc_member = self.op.cv_imread("pic/screenshot.png")
                    #    member_res = self.op.ocr.ocr(sc_member, cls=False)
                    #    member_text = "".join([line[1][0] for line in member_res[0]]) if member_res and member_res[
                    #        0] else ""

                    #    if "同意协议" in member_text:
                    #        self._click_ocr_button(sc_member, member_res, ["同意协议并加入会员", "同意协议并加入"], 0,
                    #                               debug_name="Click_Member_2")
                    #        self.op.delay(3.0)

                    #    self.op.click_back(self.device_id)
                    #    self.op.delay(1.5)
                    #    status = "TASK_DONE"



                else:
                    # ★ 终极防遮挡护盾：给予 2 次物理缓冲时间！
                    unknown_retry_dict[current_f_id] = unknown_retry_dict.get(current_f_id, 0) + 1
                    if is_reloading and unknown_retry_dict[current_f_id] <= 2:
                        #self.t_print("缓冲",f"底部被系统 Toast 弹窗遮挡，等待 2.5 秒消散后重试 ({unknown_retry_dict[current_f_id]}/2)...", indent=1)
                        self.op.delay(2.5)
                        continue  # 直接跳回大循环开头，重新截图再扫一次！
                    else:
                        self.t_print("警告", f"{current_f_id} 未知底部状态，跳过")
                        status = "SKIP"

            # 6. 处理重入
            if status == "TASK_DONE":
                # ==========================================
                # ★ 局部风控拦截：连续3次无反应直接踢飞！
                # ==========================================
                task_deadlock_dict[current_f_id] = task_deadlock_dict.get(current_f_id, 0) + 1
                if task_deadlock_dict[current_f_id] >= 5:
                    self.t_print("风控拦截", f"【{current_f_id}】连续 5 次点击无反应！账号被限或者网络卡顿，强行放弃！",
                                 self.C_RED)
                    self._close_fudai_window(anchor)
                    return "SKIP"

                self.t_print("重载", f"{current_f_id} 任务刚执行完，原地刷新确认状态...")
                self.op.delay(1.5)
                is_reloading = True
                continue

            visited_ids.add(current_f_id)

            # 7. 盲滑探测机制
            if not is_multi:
                break
            else:
                self.t_print("多福袋", "准备滑动探测下一个福袋卡片...")
                # ★ 修复滑动死区：定死在福袋标题下方 250px 处，这是绝对安全的滑动区
                swipe_y = y_start + self.dm.scale(250)
                # ★ 加大滑动幅度：从屏幕右侧 90% 狠狠滑到左侧 10%，快速滑动(300ms)确保翻页
                self.op.swipe_custom(self.device_id, int(w * 0.9), swipe_y, int(w * 0.1), swipe_y, duration=300)
                # 多给一点延迟，让卡片动画飞完，防止截图截到一半的残影
                self.op.delay(2.0, 2.5)

                # ==========================================
                # ★ 核心修复：阻断多福袋状态污染！
                # 滑动到新福袋后，必须重置重载状态，让新福袋能正常记录属于自己的 T1 初始时间！
                # ==========================================
                is_reloading = False
            # ==========================================
            # 🔄 遍历引擎结束
            # ==========================================

        self._close_fudai_window(anchor)

        if not wait_time_pool:
            # ★ 新增：如果池子是空的，且之前有福袋是因为没给钻石跳过的，返回专属的强退信号！
            if diamond_skipped:
                return "SKIP_DIAMOND"
            if low_value_skipped:
                return "SKIP_LOW_VALUE"
            if time_skipped:
                return "SKIP_TIMEOUT"  # ★ 发送超时专属信号
            return "SKIP"
        else:
            # ★ 核心修复 2：从绝对时间戳中还原真实的剩余时间，完美扣除滑屏与OCR耗时！
            min_timestamp = min(wait_time_pool)
            min_wait = max(0, int(min_timestamp - time.time()))

            # ★ 终极排雷：判断是否为多福袋，应该看“滑动看过的福袋总数”，而不是“最终参与的数量”！
            is_multi_waiting = len(wait_time_pool) > 1
            is_panel_multi = len(visited_ids) > 1

            if is_multi_waiting:
                self.t_print("时间池", f"共捕获 {len(wait_time_pool)} 个有效福袋，最小等待时间 {min_wait} 秒...")

            # 传入 is_panel_multi 标识，无论参与了几个，只要面板上出现过多个，就绝对禁止误报“提前苏醒”！
            wait_result = self._smart_sleep_and_wait(min_wait, ftype=ftype, is_multi=is_panel_multi)

            # ★ 核心拦截：如果开奖期间发现主播下播，直接返回死亡信号，拒绝虚报战果！
            if wait_result == "ROOM_DEAD":
                return "ROOM_DEAD"
            if wait_result == "FORCE_BREAK":
                return "FORCE_BREAK"
            if wait_result == "EARLY_WAKEUP":  # ★ 新增：传递纠错信号
                return "EARLY_WAKEUP"

            if len(wait_time_pool) > 1:
                return "MULTI_DRAW_PARTIAL"
            else:
                return "DRAW_FINISHED"

    def process_festival_fudai(self, wait_min, allow_fans, allow_diamond, min_prize_value=0, ignore_value_filter=False, vip_keywords=None, is_reloading=False, pos=None):
        """
        [节日专属大一统引擎]
        纯净版：绝对不触碰外部代码，不越界解析超级福袋，独立 130px 坐标撤退！
        """
        if vip_keywords is None: vip_keywords = []

        self.op.get_screenshot(self.device_id)
        sc = self.op.cv_imread("pic/screenshot.png")
        if sc is None: return "SKIP"
        h, w = sc.shape[:2]

        # ==========================================
        # ★ 纯净重构 1：物理切割与纯 OCR 确权
        # ==========================================
        y_start = int(h * 0.25)
        roi_fudai = sc[y_start:h, 0:w]
        ocr_res = self.op.ocr.ocr(roi_fudai, cls=False)

        if not ocr_res or not ocr_res[0]:
            self.op.click_back(self.device_id)
            self.op.delay(1)
            return "SKIP"

        full_text_debug = "".join([line[1][0] for line in ocr_res[0]])

        if not any(kw in full_text_debug for kw in ["剩余", "三等奖", "人参与", "福袋", "等奖", "参考价"]):
            self.t_print("异常", "未检测到节日详情页特征文字，判定面板未打开！")
            return "OPEN_PANEL_FAILED"

        def safe_close_festival_panel():
            if pos and 'cx' in pos and 'cy' in pos:
                rx, ry = pos['cx'] + random.randint(-15, 15), pos['cy'] + random.randint(-10, 10)
                self.op.click(self.device_id, (rx, ry))
                self.op.delay(1.2)
            else:
                self.op.click_back(self.device_id)
                self.op.delay(1)

        # ==========================================
        # ★ 模拟主程序的“物理切割” (切除顶部垃圾标题)
        # ==========================================
        y_cut_line = 0
        for line in ocr_res[0]:
            if "超级福袋" in line[1][0]:
                y_cut_line = line[0][0][1]
                break

        valid_lines = []
        for line in ocr_res[0]:
            cy = (line[0][0][1] + line[0][2][1]) / 2
            if cy >= y_cut_line - self.dm.scale(20):
                valid_lines.append(line)

        festival_name = ""
        y_top_limit = 0
        y_bottom_limit = h - y_start
        y_time_center = 0

        # 1. 扫描天花板、地板、时间轴
        is_zhuli = False
        for line in valid_lines:
            text = line[1][0]
            box = line[0]
            cy = (box[0][1] + box[2][1]) / 2

            if "可分享助力" in text or "好运翻倍" in text:
                is_zhuli = True

            if "超级福袋" in text:
                festival_name = text.split("超级福袋")[0].strip()
                y_top_limit = cy
            # ★ 兼容新版："已参与" 既是奖品区的地板，又是倒计时的 Y 轴中心！
            elif "当前已有" in text or "人参与" in text or "参与任务抽奖" in text or "已参与" in text:
                y_bottom_limit = cy

            # ★ 倒计时 Y 轴锚点判定放宽
            if text == "剩余" or "剩余" in text or "后开奖" in text or "后开" in text or "已参与" in text:
                y_time_center = cy

        # 动态命名：如果没提取到特定前缀，但发现是助力福袋，强行冠名！
        if is_zhuli and not festival_name:
            festival_name = "助力"

        if y_top_limit == 0:
            return "OPEN_PANEL_FAILED"

        festival_title = f"{festival_name}超级福袋" if festival_name else "节日超级福袋"

        # 2. 倒计时防干扰提取
        fudai_total_seconds = 0
        if y_time_center > 0:
            time_lines = []
            y_tolerance = self.dm.scale(25)

            # 物理收集同一水平线上的所有时间碎片 (不再依赖"剩余"二字定 X 轴)
            for line in valid_lines:
                cy = (line[0][0][1] + line[0][2][1]) / 2
                if abs(cy - y_time_center) < y_tolerance:
                    time_lines.append(line)

            time_lines = sorted(time_lines, key=lambda x: x[0][0][0])
            time_text_full = " ".join([line[1][0] for line in time_lines])

            # ★ 优先呼叫底层的神级冒号解算器 (完美兼容 "9596人 已参与 / 07 : 04 后开奖")
            t_res = self.op.check_countdown(time_text_full)
            if t_res:
                fudai_total_seconds = t_res[0]
            else:
                # 备用兜底：传统的中文字符纯数字提取
                nums = re.findall(r'\d+', time_text_full)
                if len(nums) >= 2:
                    minutes = int(nums[-2])
                    seconds = int(nums[-1])
                    if seconds >= 60: seconds = 59
                    fudai_total_seconds = minutes * 60 + seconds
                elif len(nums) == 1:
                    pure_digits = nums[0]
                    if len(pure_digits) >= 3:
                        minutes = int(pure_digits[:-2])
                        seconds = int(pure_digits[-2:])
                        if seconds >= 60: seconds = 59
                        fudai_total_seconds = minutes * 60 + seconds
                    else:
                        fudai_total_seconds = int(pure_digits)

        # 3. 核心：带物理修复的三列矩阵逆向提取法
        hats = []
        prices = []
        texts = []
        all_detected_prices = []
        condition_full_text = ""

        for line in valid_lines:
            text = line[1][0]
            box = line[0]
            cx = (box[0][0] + box[2][0]) / 2
            cy = (box[0][1] + box[2][1]) / 2

            if y_top_limit < cy < y_bottom_limit:
                if "等奖" in text:
                    # ★ 修复一：当 OCR 瞎了，丢掉“一/二/三”时，利用 X 轴物理坐标强行补齐！
                    if not any(c in text for c in ["一", "二", "三", "四", "特"]):
                        if cx < w * 0.35:
                            text = "二" + text
                        elif cx > w * 0.65:
                            text = "三" + text
                        else:
                            text = "一" + text
                    hats.append({'text': text, 'cx': cx, 'bottom': box[2][1]})
                elif any(kw in text for kw in ["参考价", "价值", "￥", "¥"]):
                    prices.append({'text': text, 'cx': cx, 'top': box[0][1], 'cy': cy})
                    nums = re.findall(r'\d+', text)
                    if nums: all_detected_prices.extend([int(n) for n in nums])
                elif "剩余" not in text and not text.isdigit():
                    texts.append({'text': text, 'cx': cx, 'cy': cy})
            elif cy > y_bottom_limit:
                condition_full_text += text

        if ("￥" in full_text_debug or "¥" in full_text_debug):
            matches_global = re.findall(r'[￥¥]\s*(\d+)', full_text_debug)
            if matches_global: all_detected_prices.extend([int(m) for m in matches_global])

        # ★ 废除了之前的 max() 全局扫荡，改由一等奖精确赋值
        ref_num = 0

        structured_prizes = []
        valid_prize_values = []  # ★ 新增极简兜底池：只存一二三等奖的真实价格
        raw_prize_concat = ""
        first_prize_concat = ""  # ★ 新增：专门存放一等奖名字的变量

        for hat in hats:
            matched_price = None
            min_x_diff = self.dm.scale(200)
            for p in prices:
                if p['top'] > hat['bottom']:
                    x_diff = abs(p['cx'] - hat['cx'])
                    if x_diff < min_x_diff:
                        matched_price = p
                        min_x_diff = x_diff

            if matched_price:
                col_texts = []
                for t in texts:
                    if hat['bottom'] < t['cy'] < matched_price['top']:
                        if abs(t['cx'] - hat['cx']) < self.dm.scale(150):
                            col_texts.append(t)

                # ★ 修复二：自下而上的链式提取法！(兼容价格与名称存在大间隙的绝杀版)
                col_texts.sort(key=lambda x: x['cy'], reverse=True)

                prize_parts = []
                if col_texts:
                    # 1. 第一步：无条件吸附最底下的一行文字
                    first_text = col_texts[0]
                    prize_parts.append(first_text)
                    last_cy = first_text['cy']

                    # 记录真实行距，用于实现“等距校验”
                    standard_gap = None

                    # 2. 第二步：向上执行严格的“动态行距”检测
                    for t in col_texts[1:]:
                        current_gap = last_cy - t['cy']

                        # ★ 核心防线 1 (绝对边界压缩)：针对三列压缩排版，将容错从 68 狠狠缩紧到 48！
                        # 超过 48 像素，绝对是跨越了图片，果断切断！
                        if current_gap > self.dm.scale(48):
                            break

                        # ★ 核心防线 2 (动态等距校验)：完美实现“间隔一致”逻辑！
                        # 如果已经确认了行距，一旦下一个间距突变（误差>15px），说明吸到了乱码或跳距，果断切断！
                        if standard_gap is not None:
                            if abs(current_gap - standard_gap) > self.dm.scale(15):
                                break
                        else:
                            standard_gap = current_gap  # 记录两行正常文字的间距作为标准

                        prize_parts.append(t)
                        last_cy = t['cy']  # 继续向上吸附

                prize_parts.sort(key=lambda x: x['cy'])
                clean_name = " ".join([pt['text'] for pt in prize_parts])

                structured_prizes.append(f"{hat['text']}：{clean_name} ({matched_price['text']})")
                raw_prize_concat += clean_name

                # ★ 极简逻辑：提取当前已确认奖项绑定的价格，放进干净的池子
                p_nums = re.findall(r'\d+', matched_price['text'])
                if p_nums:
                    valid_prize_values.extend([int(n) for n in p_nums])

                # ==========================================
                # ★ 核心修复：精准锁定一等奖，彻底阻断向下覆盖！
                # [纠错] 废除泛匹配的 "1"，改用严格前缀或复合词，防 "10份" 误伤
                # ==========================================
                if any(k in hat['text'] for k in ["一等", "1等", "特等", "一等奖"]) or hat['text'].startswith("一"):
                    first_prize_concat += clean_name

                    # 【新增】：直接把一等奖的价格锁死为最高价值！
                    if p_nums:
                        # [纠错] 改为取 p_nums[-1] 最后一个数字！
                        # 彻底防止 OCR 幻视 (如 "1参考价1899") 导致错误提取出最前面的 1
                        ref_num = int(p_nums[-1])

        # ★ 极简兜底：循环结束后，如果没找到一等奖，优先从小池子(1-3等奖)里选最大的！
        if ref_num == 0 and valid_prize_values:
            ref_num = max(valid_prize_values)
        elif ref_num == 0 and all_detected_prices:
            ref_num = max(all_detected_prices)  # 极小概率全屏找不到等级时的老兜底

        ref_value_str = f"最高价值：￥{ref_num}" if ref_num > 0 else "未标金额"

        if not structured_prizes:
            raw_prize_concat = "".join([t['text'] for t in texts])
            first_prize_concat = raw_prize_concat
        elif not first_prize_concat:
            first_prize_concat = raw_prize_concat  # 兜底：没认出一等奖，退回全量检测防漏

        final_time = f"{fudai_total_seconds // 60}分{fudai_total_seconds % 60}秒" if fudai_total_seconds > 0 else "未知"

        # === 核心打印去重引擎 ===
        last_prize = getattr(self, 'last_parsed_prize', "")
        is_new_prize = False
        clean_prize = re.sub(r'^[\W_]+', '', raw_prize_concat)
        clean_last = re.sub(r'^[\W_]+', '', last_prize)
        if raw_prize_concat and clean_prize[:10] != clean_last[:10]:
            is_new_prize = True
            self.last_parsed_prize = raw_prize_concat
            self.last_structured_prizes = structured_prizes
            self.last_parsed_value = ref_num  # 补全价值记忆

            # [架构升级] 针对节日福袋，将完整的123等奖阵列绑定绝对时间戳写入
            if not is_reloading:
                expected_timestamp = time.time() + fudai_total_seconds
                self.multi_prize_memory[expected_timestamp] = {
                    'prize': structured_prizes,  # 直接存入结构化数组，供开奖舱提取二三等奖
                    'value': ref_num
                }

        # 仅在非重载，或重载且发现漏报时打印
        if not is_reloading or is_new_prize:
            if festival_name:
                self.t_print("识别", f"发现 【{festival_name}】 节日超级福袋！", self.C_YELLOW, indent=1)
            f_prefix = f"[{festival_name}] " if festival_name else ""
            self.t_print("内容", f"【{festival_title}】 {f_prefix}| 剩余时间: {final_time} | {ref_value_str}",
                         self.C_GREEN, indent=1)
            if structured_prizes:
                self.t_print("奖品阵列", "", self.C_GREEN, indent=1)
                for p_idx, p_str in enumerate(structured_prizes):
                    prefix = "└─" if p_idx == len(structured_prizes) - 1 else "├─"
                    parts = re.split(r'[:：]', p_str, 1)
                    if len(parts) == 2:
                        tag = parts[0].strip()
                        name = parts[1].strip()
                        tag_width = sum(2 if ord(c) > 127 else 1 for c in tag)
                        padding = " " * max(0, 14 - tag_width)
                        print(f"{self.C_GREEN}                     {prefix} {tag}{padding}：{name}{self.C_RESET}")
                    else:
                        print(f"{self.C_GREEN}                     {prefix} {p_str}{self.C_RESET}")
            else:
                self.t_print("奖品", raw_prize_concat, indent=2)
        else:
            # ★ 新增：重载时的确认状态日志，与超级福袋完美对齐！
            self.t_print("状态更新", f"节日福袋 正在确认开奖状态 | 剩余时间: {final_time}", indent=1)

        # ==========================================
        # ★ 阶段 4：黑白名单与金额拦截 (隔离VIP，一等奖判定)
        # ==========================================
        skip_current = False
        has_privilege = False
        has_luxury_privilege = False  # ★ 新增

        # ★ 核心纠正 1：剥离普通福袋专属的 vip_keywords，只使用全局 want_list
        combined_want_list = self.want_list

        # ★ 核心纠正 2：强制使用一等奖内容判定特权，无视二三等奖！
        target_check_text = first_prize_concat if first_prize_concat else raw_prize_concat

        for kw in combined_want_list:
            if kw and (kw in target_check_text or kw in condition_full_text):
                if not is_reloading:
                    self.t_print("特权激活", f"节日一等奖匹配到白名单 '{kw}'，无视金额强行咬住！", self.C_GREEN)
                has_privilege = True
                break

            # ★ 新增：遍历豪华名单
        for kw in getattr(self, 'luxury_list', []):
            if kw and (kw in target_check_text or kw in condition_full_text):
                if not is_reloading:
                    self.t_print("豪华特权激活", f"节日一等奖匹配到豪华名单 '{kw}'，无视金额与时间限制，死磕到底！",
                                 self.C_MAGENTA)
                has_privilege = True
                has_luxury_privilege = True
                break

        if not is_reloading:
            if not ignore_value_filter:
                # ★ 黑名单同样只检查一等奖的内容！
                full_check_text = target_check_text + condition_full_text
                if self._check_content_filter(full_check_text):
                    if not is_reloading:
                        self.t_print("黑名单拦截", "一等奖内容触碰黑名单，强制跳过！", self.C_YELLOW)
                    skip_current = True

            if not skip_current and not ignore_value_filter and not has_privilege:
                if min_prize_value > 0 and 0 < ref_num < min_prize_value:
                    if not is_reloading:
                        self.t_print("价值拦截", f"奖品价值 ￥{ref_num} 低于配置阈值 ￥{min_prize_value}，强制跳过！",
                                     self.C_YELLOW)
                    skip_current = True

            # ★确保极限跳过和超时受到 skip_current 保护
            if not skip_current:
                if fudai_total_seconds > wait_min * 60:
                    if has_luxury_privilege:
                        if not is_reloading:
                            self.t_print("豪华死磕",
                                         f"倒计时 {fudai_total_seconds}s 超过限制，但触发豪华特权，无视时间死磕！",
                                         self.C_MAGENTA)
                    else:
                        if not is_reloading:
                            self.t_print("超时跳过", f"时间过长: {fudai_total_seconds}s > {wait_min * 60}s")
                        skip_current = True

                elif 0 < fudai_total_seconds < 15:
                    # ★ 核心修复：状态前置！如果画面上明确写着“等待开奖”等成功字眼，绝对不跳过！
                    if not any(kw in full_text_debug for kw in
                               ["开奖时需回到", "否则抽奖失败", "邀请一位好友", "中奖概率翻倍", "抽奖任务已完成", "等待开奖"]):
                        if not is_reloading:
                            self.t_print("极限跳过",
                                         f"剩余时间极少({fudai_total_seconds}s)放弃参与！就地休眠等待下一波...")
                        safe_close_festival_panel()
                        return "DRAW_FINISHED_NO_COUNT"

        if skip_current:
            safe_close_festival_panel()
            return "SKIP"

        # ==========================================
        # ★ 阶段 5：状态核验
        # ==========================================
        is_success_confirmed = False
        success_features = [
            "开奖时需回到直播间", "否则抽奖失败", "邀请一位好友进入直播间助力",
            "邀请好友中奖概率翻倍", "中奖概率翻倍", "抽奖任务已完成", "等待开奖中", "等待开奖"
        ]

        for kw in success_features:
            if kw in full_text_debug:
                is_success_confirmed = True
                break

        if is_success_confirmed:
            self.t_print("状态", "正在精准入池挂机...", indent=1)
            # ★ 修复：废除老旧的 anchor 坐标依赖，直接呼叫刚刚重构的纯净版关闭函数！
            safe_close_festival_panel()
            wait_result = self._smart_sleep_and_wait(fudai_total_seconds, ftype='FESTIVAL')
            if wait_result in ["ROOM_DEAD", "FORCE_BREAK", "EARLY_WAKEUP"]: return wait_result
            return "DRAW_FINISHED"

        # ==========================================
        # ★ 阶段 6：底部按钮探测
        # ==========================================
        target_btn = None
        btn_text = ""
        bottom_lines = []

        for line in ocr_res[0]:
            cy = (line[0][0][1] + line[0][2][1]) / 2
            if cy > y_bottom_limit:
                bottom_lines.append(line)

        if bottom_lines:
            bottom_lines = sorted(bottom_lines, key=lambda x: x[0][2][1], reverse=True)
            action_keywords = [
                "关注主播", "一键发表评论", "发表评论", "键发表",
                "加入粉丝团", "粉丝团", "开始观看", "观看直播",
                "开通店铺会员", "去开通", "去完成"
            ]
            for line in bottom_lines:
                text = line[1][0]
                if any(kw in text for kw in success_features):
                    self.t_print("状态", f"底部识别到成功状态 '{text}'，成功进入挂机池！", indent=1)
                    # ==========================================
                    # ★ 核心补漏：挂机前必须关掉面板，保证画面清爽！
                    # ==========================================
                    safe_close_festival_panel()
                    wait_result = self._smart_sleep_and_wait(fudai_total_seconds, ftype='FESTIVAL')
                    if wait_result in ["ROOM_DEAD", "FORCE_BREAK", "EARLY_WAKEUP"]: return wait_result
                    return "DRAW_FINISHED"
                if any(kw in text for kw in action_keywords):
                    target_btn = line
                    btn_text = text
                    break

        if not target_btn:
            self.t_print("警告", "底部未发现任何有效按钮或成功状态，安全撤退！")
            safe_close_festival_panel()
            return "SKIP"

        # ==========================================
        # ★ 阶段 7：连招点击
        # ==========================================
        box = target_btn[0]
        w_btn = box[2][0] - box[0][0]
        h_btn = box[2][1] - box[0][1]

        safe_x = int(w_btn * 0.15)
        safe_y = int(h_btn * 0.15)
        cx = int(box[0][0]) + random.randint(safe_x, max(safe_x, int(w_btn) - safe_x))
        cy = int(box[0][1]) + random.randint(safe_y, max(safe_y, int(h_btn) - safe_y)) + y_start

        self.t_print("动作", f"节日福袋 {btn_text}任务", indent=1)
        self.t_print("面状仿生", f"锁定区域 “{btn_text}” -> 随机落点坐标 ({cx}, {cy})", indent=2)
        self.op.click(self.device_id, (cx, cy))
        self.op.delay(1)
        return "TASK_DONE"

    def _click_ocr_button(self, sc, ocr_res, keywords, y_offset, exact_match=False, debug_name="OCR_Click"):
        """遍历底部 OCR 结果，找到目标按钮并精准点击 (支持全字精确匹配，并保存可视化留档)"""
        if not ocr_res or not ocr_res[0]: return False
        # 彻底免疫上方“任务说明文字”与真正按钮文字重叠的致命误判！
        sorted_lines = sorted(ocr_res[0], key=lambda x: x[0][2][1], reverse=True)

        for line in sorted_lines:
            text = line[1][0]

            # 核心判定逻辑：精确匹配 vs 包含匹配
            is_match = False
            if exact_match:
                if any(text == kw for kw in keywords): is_match = True
            else:
                if any(kw in text for kw in keywords): is_match = True

            if is_match:
                box = line[0]
                # 1. 计算出这个按钮的真实物理宽度和高度
                w = box[2][0] - box[0][0]
                h = box[2][1] - box[0][1]

                # 2. 刨除边缘 15% 的安全区（防止点到按钮外面的空气）
                safe_x = int(w * 0.15)
                safe_y = int(h * 0.15)

                # 3. 在安全的宽、高范围内，进行真正的大范围随机散列！
                # 比如“一键发表评论”宽 300 像素，那手指就会在中间的 210 像素里随便瞎点
                rx = int(box[0][0]) + random.randint(safe_x, max(safe_x, int(w) - safe_x))
                ry = int(box[0][1]) + random.randint(safe_y, max(safe_y, int(h) - safe_y)) + y_offset

                # 将随机出来的值赋给坐标
                cx, cy = rx, ry
                self.t_print("面状仿生", f"锁定区域 “{text}” -> 随机落点坐标 ({cx}, {cy})", indent=2)

                # ==================================================
                # ★ 恢复调试画图：将相对框转化为全屏绝对框并留档
                # ==================================================
                if sc is not None:
                    # 算出它在全屏中的绝对物理方框
                    abs_box = (int(box[0][0]), int(box[0][1]) + y_offset, int(box[2][0]), int(box[2][1]) + y_offset)
                    # 调用底层的画图模块，保存到 debug_pic 文件夹下
                    self.op.save_debug_image(sc, abs_box, debug_name, f"Action_{debug_name}", click_pos=(cx, cy))

                self.op.click(self.device_id, (cx, cy))
                return True
        return False

    def process_normal_fudai(self, wait_min, allow_fans, allow_diamond, min_prize_value=0, ignore_value_filter=False,
                             vip_keywords=None, action_area_height=280, action_area_box=None, is_reloading=False):
        """
        [V8.6 极简防弹窗版] 增加连招静默重载日志与余额不足充值弹窗物理拦截
        """
        if vip_keywords is None:
            vip_keywords = []

        self.op.get_screenshot(self.device_id)
        sc = self.op.cv_imread("pic/screenshot.png")
        if sc is None:
            return "SKIP"

        # ==========================================
        # ★ 弹窗突发拦截器：极限卡点开奖捕获
        # ==========================================
        if is_reloading:
            if self.match_template_multiscale_adaptive(sc, 'gongxichouzhong') or \
                    self.match_template_multiscale_adaptive(sc, 'yijiansongchu') or \
                    self.match_template_multiscale_adaptive(sc, 'zengsongliwu') or \
                    self.match_template_multiscale_adaptive(sc, 'normal_zhidaole') or \
                    self.match_template_multiscale_adaptive(sc, 'meichouzhong'):
                # print(">>> [突发开奖] 普通福袋任务重载时已当场开奖！中止解析，移交开奖捕获引擎...")
                self._wait_for_open_loop(ftype='NORMAL')
                self.op.click_back(self.device_id)  # 物理关闭底层残留的福袋面板
                self.op.delay(1.5)
                return "DRAW_FINISHED"

        h, w = sc.shape[:2]
        anchor = self.match_template_multiscale_adaptive(sc, 'normal_fudai_title')

        # ==========================================
        # ★ 核心修复：普通福袋标题变种 (模板 + OCR 双重兜底)
        # ==========================================
        if not anchor:
            # 1. 优先使用你的新武器：极速雷达寻找“已参与”按钮！
            if self.match_template_multiscale_adaptive(sc, 'yicanyu_btn'):
                self.t_print("物理兜底", "标题变异，但极速雷达发现'已参与'按钮，强制放行！")
                anchor = {'tl': (0, int(h * 0.25)), 'h': 0}
            else:
                # 2. 如果模板没认出来，再动用 OCR 扫描中半屏
                roi_chk = sc[int(h * 0.25):int(h * 0.8), 0:w]
                res_chk = self.op.ocr.ocr(roi_chk, cls=False)
                if res_chk and res_chk[0]:
                    chk_text = "".join([line[1][0] for line in res_chk[0]])
                    if "倒计时" in chk_text and any(kw in chk_text for kw in ["已参与", "已参", "个福袋", "人已参与"]):
                        self.t_print("物理兜底", "标题变异，OCR 确权成功，强制放行！")
                        anchor = {'tl': (0, int(h * 0.25)), 'h': 0}

        if not anchor:
            if is_reloading:
                return "OPEN_PANEL_FAILED_RELOAD"
            return "OPEN_PANEL_FAILED"

        # ==========================================
        # ★ 新增：普通福袋标题“纯净度”绝对物理隔离检测
        # ==========================================
        if not is_reloading:
            # 1. 物理隔离：在标题锚点的水平高度，切出一个横向贯穿全屏的狭长条 (避开下方所有内容)
            y_t_top = max(0, anchor['tl'][1] - self.dm.scale(15))
            y_t_bottom = anchor['tl'][1] + anchor['h'] + self.dm.scale(15)
            roi_title = sc[y_t_top:y_t_bottom, 0:w]

            # 2. 对这个狭长条进行独立 OCR
            res_title_ocr = self.op.ocr.ocr(roi_title, cls=False)
            if res_title_ocr and res_title_ocr[0]:
                title_text = "".join([line[1][0] for line in res_title_ocr[0]])

                # 3. 提取出所有的中文字符，并拼接成一个纯汉字的字符串
                chinese_only_str = "".join(re.findall(r'[\u4e00-\u9fa5]', title_text))

                # 4. 纯净度过滤：直接把 "福袋" 这个词整体抹除
                extra_chinese = chinese_only_str.replace("福袋", "")

                # 5. 宣判：如果抹除 "福袋" 后，还有剩余的汉字（比如"麻将","游戏"），当场击杀！
                if len(extra_chinese) > 0:
                    self.t_print("标题过滤", f"识别到非纯净标题 '{title_text}'，判定为垃圾福袋，切房！")
                    self._close_fudai_window(anchor)
                    return "SKIP"

        y_start = anchor['tl'][1] + anchor['h'] if anchor else int(h * 0.22)
        roi_fudai = sc[y_start:h, 0:w]
        ocr_res = self.op.ocr.ocr(roi_fudai, cls=False)

        if not ocr_res or not ocr_res[0]:
            self.t_print("异常", "普通福袋提取舱视觉迷失！")
            self._close_fudai_window(anchor)
            return "SKIP"

        # ==========================================
        # ★ 恢复：全景侦测日志输出
        # ==========================================
        full_text_debug = "".join([line[1][0] for line in ocr_res[0]])
        #print(f">>> [全景侦测] '{full_text_debug}'")

        # --- 阶段 1：锚点探测 ---
        y_bottom_limit = h - y_start
        floor_y = h - y_start
        condition_kws = ["参与条件", "发送评论", "已达成", "未达成", "粉丝团", "亲密度"]

        for line in ocr_res[0]:
            text = line[1][0]
            if any(kw in text for kw in condition_kws):
                if line[0][0][1] < y_bottom_limit:
                    y_bottom_limit = line[0][0][1]
            if any(kw in text for kw in ["国家反诈", "提醒", "中途离开", "请留在", "风险", "防诈骗", "诱导"]):
                if line[0][0][1] < floor_y:
                    floor_y = line[0][0][1]

        prize_text = ""
        fudai_total_seconds = 0
        ref_num = 0
        condition_full_text = ""

        # ==========================================
        # ★ 终极缓存引擎：普通福袋时间戳缓存
        # ==========================================
        if not hasattr(self, 'fudai_time_cache_normal'):
            self.fudai_time_cache_normal = 0

        # ★ 新增前置雷达：预先锁定“倒计时”三个字的物理 X/Y 坐标
        dao_anchor_x = -1
        dao_anchor_y = -1
        for line in ocr_res[0]:
            if "倒计时" in line[1][0]:
                dao_anchor_x = (line[0][0][0] + line[0][2][0]) / 2
                dao_anchor_y = line[0][0][1]  # 记录顶部高度
                break

        # --- 阶段 2：三维提取 ---
        for line in ocr_res[0]:
            text = line[1][0]
            box = line[0]
            cy = (box[0][1] + box[2][1]) / 2

            # ★ 绝对结界：时间提取必须严格缩进在这个 if 内部！
            if cy < y_bottom_limit:

                # ★ 倒计时榨取算法 (物理空间绑定版)
                is_time_box = False
                # 特征 1：文本自带冒号、后、开等明确字眼
                if any(k in text for k in ["倒计时", ":", "：", "后", "开"]):
                    is_time_box = True
                # 特征 2：物理挂载！哪怕没有冒号，只要它悬浮在“倒计时”正上方，直接逮捕！
                elif dao_anchor_x != -1:
                    curr_x = (box[0][0] + box[2][0]) / 2
                    curr_bottom_y = box[2][1]
                    # X轴偏离不超过80像素，且在倒计时上方80像素内
                    if abs(curr_x - dao_anchor_x) < self.dm.scale(80) and 0 < (
                            dao_anchor_y - curr_bottom_y) < self.dm.scale(80):
                        is_time_box = True

                if is_time_box:
                    # ★ 如果是重载，直接无视所有的文字时间提取，跳过！
                    if not is_reloading:

                        # ==========================================
                        # ★ 极简纯数字倒推引擎
                        # ==========================================
                        if fudai_total_seconds == 0:
                            t_res = self.op.check_countdown(text)
                            if t_res:
                                fudai_total_seconds = t_res[0]
                            else:
                                pure_digits = re.sub(r'\D', '', text)
                                if pure_digits:
                                    if len(pure_digits) > 4:
                                        pure_digits = pure_digits[-4:]

                                    if len(pure_digits) <= 2:
                                        fudai_total_seconds = int(pure_digits)
                                    else:
                                        minutes = int(pure_digits[:-2])
                                        seconds = int(pure_digits[-2:])
                                        if seconds >= 60: seconds = 59
                                        fudai_total_seconds = minutes * 60 + seconds
                    continue  # 提取完时间，直接 continue，不要进入下面的奖品名拼接逻辑！

                # 如果不是时间，且在结界内，那就是奖品名字
                if not is_time_box:
                    if any(noise in text for noise in
                           ["人已参加", "人参与", "个福袋", "份福袋", "额外附赠", "月付", "钻石"]):
                        continue
                    clean_prize = text.replace("倒计时", "").replace("福袋", "").strip()
                    if clean_prize:
                        prize_text += clean_prize

            else:
                # ==========================================
                # ★ 核心排雷：修复幽灵变量！必须在这里收集任务区的文字！
                # 否则黑/白名单根本扫描不到评论区，等级限制拦截也会彻底失效！
                # ==========================================
                if cy < floor_y:
                    condition_full_text += text

        # ★ 结算时间缓存逻辑
        if not is_reloading:
            # 第一次扫描，存入绝对时间戳
            self.fudai_time_cache_normal = time.time() + fudai_total_seconds
        else:
            # 重载免检：用绝对时间戳减去当前时间，自动扣除做任务消耗掉的时间！
            fudai_total_seconds = max(0, int(self.fudai_time_cache_normal - time.time()))

        # --- 阶段 3：精简日志输出 (V8.6 重大优化) ---
        full_text = "".join([line[1][0] for line in ocr_res[0]])

        # ★ 独立按钮精确匹配
        is_finished = False

        # ==================================================
        # ★ 深度修复：优先使用图片模板识别粉色“已参与”按钮
        # 只要画面里出现了你截好的粉色按钮，直接判定为成功！
        # ==================================================
        if self.match_template_multiscale_adaptive(sc, 'yicanyu_btn'):
            self.t_print("状态确权", "极速雷达锁定'已参与'按钮图标！", indent=1)
            is_finished = True
        else:
            for line in ocr_res[0]:
                txt = line[1][0].strip()
                # 只有当文字恰好完全等于按钮上的字时，才认定已参与
                if txt in ["已参与", "参与成功", "已参与", "等待开奖", "已参", "等待"]:
                    is_finished = True
                    break

        if not is_finished:
            log_task = condition_full_text
            noise_words = ["国家反诈", "抖音提醒", "防诈骗", "诱导消费", "谨慎辨别", "钻石", "1钻", "加入粉丝团"]
            for nw in noise_words:
                log_task = log_task.replace(nw, "")

            # ★ 精简逻辑：只在第一次进福袋时打印长篇信息，连招刷新时只打印状态
            if not is_reloading:
                self.t_print("内容",
                             f"普通福袋 | 奖品: {prize_text.strip()} | 剩余: {fudai_total_seconds}s | 价值: ￥{ref_num}",
                             self.C_GREEN, indent=1)
                if prize_text.strip():
                    self.last_parsed_prize = prize_text.strip()
                    self.last_parsed_value = ref_num  # 补全价值记忆

                    # [架构升级] 并发隔离存储
                    expected_timestamp = time.time() + fudai_total_seconds
                    self.multi_prize_memory[expected_timestamp] = {
                        'prize': prize_text.strip(),
                        'value': ref_num
                    }
                if log_task.strip():
