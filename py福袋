        # ==========================================
        now = datetime.datetime.now()
        current_time_val = now.hour + now.minute / 100.0

        # 1. 启动时是否在息屏时段？
        if screen_off_start != screen_off_end:
            if screen_off_start > screen_off_end:
                is_screen_off = current_time_val >= screen_off_start or current_time_val < screen_off_end
            else:
                is_screen_off = screen_off_start <= current_time_val < screen_off_end
            if is_screen_off:
                print(">>> [启动拦截] 当前处于深度息屏时段！直接进入休眠待机...")
                self._screen_off_sleep_loop(screen_off_start, screen_off_end)

        # 2. 启动时是否在午休/夜间休眠时段？
        if night_sleep_start > night_sleep_end:
            is_night_sleep = current_time_val >= night_sleep_start or current_time_val < night_sleep_end
        else:
            is_night_sleep = night_sleep_start <= current_time_val < night_sleep_end

        is_day_sleep = day_sleep_start <= current_time_val < day_sleep_end
        is_evening_sleep = evening_sleep_start <= current_time_val < evening_sleep_end

        if is_night_sleep or is_day_sleep or is_evening_sleep:
            if is_night_sleep:
                s_start, s_end, sleep_name = night_sleep_start, night_sleep_end, "夜间休眠"
            elif is_day_sleep:
                s_start, s_end, sleep_name = day_sleep_start, day_sleep_end, "午间休眠"
            else:
                s_start, s_end, sleep_name = evening_sleep_start, evening_sleep_end, "傍晚休眠"
            print(f">>> [启动拦截] 当前处于【{sleep_name}】时段！直接进入休眠待机...")
            self._anti_burn_sleep_loop(s_start, s_end, sleep_name)

        # ==========================================
        # [系统底座] 状态检测与冷启动动态调度 (V5.7 弹窗击杀版 - 兼容全机型加强)
        # ==========================================
        is_foreground = False
        try:
            # 策略 A：查询 Activity 活动栈 (最稳定，完美兼容鸿蒙/MIUI/澎湃/ColorOS)
            cmd_act = f"adb -s {device_id} shell dumpsys activity activities"
            # 增加 timeout=3 防止 ADB 进程假死导致的无限等待
            out_act = subprocess.check_output(cmd_act, shell=True, timeout=3).decode('utf-8', 'ignore')
            for line in out_act.splitlines():
                # 寻找当前处于唤醒和展示状态的 Activity
                if "mResumedActivity" in line and "com.ss.android.ugc.aweme" in line:
                    is_foreground = True
                    break

            # 策略 B：查询 Window 窗口栈 (备用兜底，兼容老旧安卓设备)
            if not is_foreground:
                cmd_win = f"adb -s {device_id} shell dumpsys window"
                out_win = subprocess.check_output(cmd_win, shell=True, timeout=3).decode('utf-8', 'ignore')
                for line in out_win.splitlines():
                    if ("mCurrentFocus" in line or "mFocusedApp" in line) and "com.ss.android.ugc.aweme" in line:
                        is_foreground = True
                        break
        except subprocess.TimeoutExpired:
            self.t_print("警告", "ADB 查询设备前台状态超时，推测设备轻微卡顿。")
        except Exception as e:
            print(f">>> [调试] 前台检测发生异常: {e}")
            pass

        if is_foreground:
            print(">>> [系统] 抖音已在前台，直接执行热恢复...")
        else:
            print(">>> [系统] 抖音不在前台，执行【安全冷启动】策略...")

            # ==========================================
            # ★ 核心修复：冷启动前强制发送物理亮屏指令，防止黑屏死锁！
            # ==========================================
            self.op.adb_key_event(device_id, 224)
            self.op.delay(1.5)

            # 1. 温和清理后台进程，替代粗暴强杀 (因检测到应用已在后台，am kill 非常安全)
            subprocess.run(f"adb -s {device_id} shell am kill com.ss.android.ugc.aweme", shell=True,
                           stdout=subprocess.DEVNULL)
            self.op.delay(1.0)

            # 2. 唤醒 App
            self.op.start_app(device_id)

            # 3. 动态显式等待引擎 (最大超时 20s)
            max_wait_seconds = 20
            print(f">>> [系统] 正在动态等待页面渲染 (最大超时 {max_wait_seconds}s)...")

            boot_success = False
            for i in range(max_wait_seconds):
                self.op.delay(1.0)
                self.op.get_screenshot(device_id, silent=True)
                sc_boot = self.op.cv_imread("pic/screenshot.png")
                if sc_boot is None: continue

                h, w = sc_boot.shape[:2]

                # A. 极速侦测：是否已安全抵达首页
                if self.match_template_multiscale_adaptive(sc_boot, 'nav_home_active') or \
                        self.match_template_multiscale_adaptive(sc_boot, 'nav_search_icon'):
                    print(f">>> [系统] 冷启动完成！耗时约 {i + 1} 秒，已确认抵达首页。")
                    boot_success = True
                    break

                # B. 合规弹窗与升级弹窗击杀 (每隔2秒扫一次 OCR，节省算力)
                if i % 2 == 0:
                    roi_popup = (int(w * 0.1), int(h * 0.4), int(w * 0.9), int(h * 0.9))
                    popup_text = self.op.analyse_area_text(sc_boot, roi_popup, "弹窗侦测")

                    # ==========================================
                    # ★ 核心修复：扩充冷启动弹窗 OCR 触发词库与击杀词库
                    # ==========================================
                    # [可调节参数] 触发词库：只要中下半屏识别到以下词汇，立刻判定有弹窗阻挡并启动精细扫描
                    trigger_keywords = ["青少年", "保护指引", "同意", "以后再说", "暂不", "新版本", "更新", "升级",
                                        "检测到更新", "立即升级"]

                    if any(kw in popup_text for kw in trigger_keywords):
                        print(f">>> [拦截] 发现开屏阻断弹窗，准备执行强寻址击杀...")
                        res_ocr = self.op.ocr.ocr(sc_boot[roi_popup[1]:roi_popup[3], roi_popup[0]:roi_popup[2]],
                                                  cls=False)
                        if res_ocr and res_ocr[0]:
                            for line in res_ocr[0]:
                                text_piece = line[1][0]
                                # [可调节参数] 击杀词库：扫描具体按钮文本，匹配成功后执行物理点击
                                click_keywords = ["我知道了", "同意", "关闭", "以后再说", "暂不", "取消", "忽略",
                                                  "暂不更新"]
                                if any(ck in text_piece for ck in click_keywords):
                                    cx = int((line[0][0][0] + line[0][2][0]) / 2) + roi_popup[0]
                                    cy = int((line[0][0][1] + line[0][2][1]) / 2) + roi_popup[1]
                                    print(f">>> [动作] 点击放行/拒绝按钮: '{text_piece}' ({cx}, {cy})")
                                    self.op.click(device_id, (cx, cy))
                                    self.op.delay(2.0)
                                    break

            if not boot_success:
                self.t_print("警告", "冷启动超时或卡在广告中，交由主逻辑兜底。")

        print()

        # ==========================================
        # ★★★ 导航路由 (带强杀重试兜底版) ★★★
        # ==========================================
        is_ready = False
        max_nav_retries = 3  # 最多给 3 次重生机会

        # ==========================================
        # ★ 新增：启动前置免检探测！如果已经在直播间，直接截胡！
        # ==========================================
        self.op.get_screenshot(device_id, silent=True)
        sc_init = self.op.cv_imread("pic/screenshot.png")
        if sc_init is not None and self.nav.check_is_in_live_room(sc_init):
            self.t_print("导航", "检测到已在直播间内，开始寻找福袋！...")
            is_ready = True
        for nav_attempt in range(max_nav_retries):
            # ★ 核心修复：如果上面免检已经通过，直接跳出寻路循环！防止 is_ready 被覆盖！
            if is_ready:
                break

            if run_mode == 1:
                is_ready = self.nav.enter_following_live(device_id)
            elif run_mode == 2:
                is_ready = self.nav.enter_live_square(device_id)
            elif run_mode == 3:
                is_ready = self.nav.enter_search_live(device_id, search_kw)
            elif run_mode == 0:
                # 模式0假设用户已经手动进房
                print(">>> [提示] 固定模式已就绪，请确保当前在直播间")
                is_ready = True

            if not is_ready:
                # 最后的兜底检查
                self.op.get_screenshot(device_id)
                sc = self.op.cv_imread("pic/screenshot.png")
                if self.nav.check_is_in_live_room(sc):
                    is_ready = True
                    break
                elif run_mode != 0:
                    if nav_attempt < max_nav_retries - 1:
                        print(
                            f">>> [启动兜底] 进房失败 ({nav_attempt + 1}/{max_nav_retries})，触发底层物理强杀并重试...")
                        self.op.force_restart_douyin(device_id)
                        continue
                    else:
                        print(">>> [严重] 连续多次无法进入目标直播间，脚本退出")
                        self.send_wechat_push(
                            title="[异常停止] 脚本自动退出告警",
                            content=f"<b>设备ID：</b>{self.device_id}<br><b>设备别名：</b>{self.device_alias}<br><b>状态：</b>自动停止运行<br><b>原因：</b>连续 {max_nav_retries} 次尝试无法进入目标直播间，导航彻底失败。"
                        )
                        return
            else:
                break

        fail_count = 0
        is_original_room = True  # ★ 新增：标记当前是否在用户指定的初始直播间
        is_reloading = False  # ★ [新增] 标记当前是否处于做完任务后的重载状态
        # ★ 新增：初始进房，赋予免检特权
        self.just_switched_room = True
        self.just_switched_room_count = 0

        # ==========================================
        # ★ 新增：驻留时长与轮次统计系统
        # ==========================================
        room_start_time = time.time()  # 记录进房时间
        next_value_check_time = room_start_time + max_stay_minutes * 60  # 计算第一次大考时间
        # ★ [新增代码] 2.5小时防卡死点火时间戳与配置参数
        self.last_clean_restart_time = time.time()
        RESTART_INTERVAL_HOURS = 2.5  # [可手动调节参数] 运行多少小时后主动冷启动清理内存
        room_fudai_count = 0  # 记录薅羊毛轮次
        global_fudai_count = 0  # 用于巡航模式的全局累计计数
        room_switch_count = 0  # 连续切房计数器
        low_value_streak = 0  # 连续低价值福袋计数器
        continuous_overflow_count = 0  # ★ 新增：全局连续防溢出触发计数器

        # ★ 新增：解析连抽参数与空等计数器
        if isinstance(cruise_rounds, (list, tuple)) and len(cruise_rounds) == 2:
            current_target_rounds = random.randint(cruise_rounds[0], cruise_rounds[1])
        else:
            current_target_rounds = int(cruise_rounds)
        room_empty_wait = 0  # 防止主播画大饼的干等计数器

        # ==========================================
        # ★ 定义切房拦截器内联函数 (双轨防溢出规则)
        # ==========================================
        def execute_room_switch(reason="NORMAL"):
            # ★ 引入 continuous_overflow_count，允许内联函数跨域修改
            nonlocal room_switch_count, is_original_room, room_fudai_count, low_value_streak, current_target_rounds, room_empty_wait, is_reloading, run_mode, fail_count, continuous_overflow_count

            # ★ 核心修复 1：切房时，必须强行打断所有的“重载验证”状态！
            is_reloading = False

            # ★ 核心修复 2：彻底清空上一房间的福袋记忆
            self.fudai_time_cache = {}
            self.fudai_anchor_cache = {}
            self.last_parsed_prize = ""
            self.last_parsed_f_id = ""
            self.global_deadlock_count = 0  # ★ 新增：切房时清零全局死锁计数

            # ==========================================
            # ★ 核心修复 3：切房/重启 前置时段拦截 (防下班前无意义瞎折腾)
            # ==========================================
            now_chk = datetime.datetime.now()
            cur_val = now_chk.hour + now_chk.minute / 100.0
            is_bed = False

            # 把所有的休息时段都查一遍 (包括咱们上一回合加的傍晚休眠)
            if screen_off_start != screen_off_end:
                is_bed = (
                            cur_val >= screen_off_start or cur_val < screen_off_end) if screen_off_start > screen_off_end else (
                            screen_off_start <= cur_val < screen_off_end)
            if not is_bed and night_sleep_start != night_sleep_end:
                is_bed = (
                            cur_val >= night_sleep_start or cur_val < night_sleep_end) if night_sleep_start > night_sleep_end else (
                            night_sleep_start <= cur_val < night_sleep_end)
            if not is_bed and day_sleep_start != day_sleep_end:
                is_bed = day_sleep_start <= cur_val < day_sleep_end
            if not is_bed and evening_sleep_start != evening_sleep_end:
                is_bed = evening_sleep_start <= cur_val < evening_sleep_end

            if is_bed:
                self.t_print("时段拦截", "已到休息时段！拦截切房与防卡死重启操作，直接移交主控引擎休眠...")
                return  # 直接 Return，主循环下一秒就会捕获状态并安排睡觉！

            # ==========================================
            # ★ 新增：定时物理释放内存拦截器 (仅限巡航模式)
            # ==========================================
            # 逻辑更新：只有在 run_mode 为 1(关注)、2(广场)、3(搜索) 时，才触发 2.5 小时清理。模式 0 绝对免疫。
            if run_mode in [1, 2, 3] and (time.time() - self.last_clean_restart_time) > RESTART_INTERVAL_HOURS * 3600:
                self.t_print("防卡死", f"已连续运行超 {RESTART_INTERVAL_HOURS} 小时，当前轮次已完美收官！")
                self.t_print("防卡死", "正在截断切房流程，准备执行物理清场与冷启动释放内存...")

                # 1. 温柔退场：连按 6 次返回键退回外部，关掉所有残留弹窗
                for _ in range(6):
                    self.op.adb_key_event(device_id, 4)
                    self.op.delay(0.8)

                # 回到手机桌面 (Home键)，让系统自然挂起应用
                self.op.adb_key_event(device_id, 3)
                self.op.delay(2.0)

                # 2. 温和清理：只杀后台缓存进程 (不破坏系统状态)，然后重新唤醒
                subprocess.run(f"adb -s {device_id} shell am kill com.ss.android.ugc.aweme", shell=True,
                               stdout=subprocess.DEVNULL)
                self.op.delay(2.0)
                self.op.start_app(device_id)
                self.op.delay(8.0)  # 给重新拉起留出充足的缓冲时间

                # 3. 根据当前运行模式动态寻路进房 (无需处理模式 0)
                nav_success = False
                if run_mode == 1:
                    nav_success = self.nav.enter_following_live(device_id)
                elif run_mode == 2:
                    nav_success = self.nav.enter_live_square(device_id)
                elif run_mode == 3:
                    nav_success = self.nav.enter_search_live(device_id, search_kw)

                # 导航兜底重试机制
                if not nav_success:
                    self.op.force_restart_douyin(device_id)
                    if run_mode == 1:
                        self.nav.enter_following_live(device_id)
                    elif run_mode == 2:
                        self.nav.enter_live_square(device_id)
                    elif run_mode == 3:
                        self.nav.enter_search_live(device_id, search_kw)

                # 4. 彻底重置所有状态与计时器 (消除跨周期错乱记忆)
                self.last_clean_restart_time = time.time()  # 重置 2.5 小时计时器
                self.soft_rescue_history.clear()
                room_switch_count = 0
                low_value_streak = 0
                is_original_room = False
                room_fudai_count = 0
                room_empty_wait = 0
                fail_count = 0  # ★ 排雷修复：异常探针清零，防假死熔断
                self.just_switched_room = True  # ★ 赋予苏醒后的首个房间免检特权
                self.just_switched_room_count = 0
                if isinstance(cruise_rounds, (list, tuple)) and len(cruise_rounds) == 2:
                    current_target_rounds = random.randint(cruise_rounds[0], cruise_rounds[1])
                else:
                    current_target_rounds = int(cruise_rounds)
                self.cleaner.check_and_cleanup(self.op_count)

                # ★ 核心阻断：直接 return，绝不执行下方的常规切房滑动逻辑！
                return

            # ==========================================
            # ★ 核心重构：防溢出三轨分离裁判所 (恢复挑食退房)
            # ==========================================
            is_malignant_overflow = False  # 恶性死锁触发标记
            is_benign_overflow = False  # 良性挑食退房标记

            # 【轨道 C】绝对健康：人工干预、遇到付费门槛。清零一切怀疑。
            if reason in ["DIAMOND", "MANUAL"]:
                room_switch_count = 0
                low_value_streak = 0
                continuous_overflow_count = 0  # 绝对清零全局死锁

            # 【轨道 B】风水极差 (挑食过滤)：连续遇到价值低或黑名单
            elif reason in ["LOW_VALUE", "BENIGN"]:
                room_switch_count = 0  # 证明UI流畅，恶性空转清零
                continuous_overflow_count = 0  # 证明UI流畅，全局死锁清零！(绝不强杀)
                low_value_streak += 1
                is_benign_overflow = (low_value_streak >= max_low_value_streak)

            # 【轨道 A】恶性空转：无福袋、超时、主播下播，高度疑似卡死
            else:
                low_value_streak = 0  # 发生恶性空转时打断挑食连击
                room_switch_count += 1
                is_malignant_overflow = (room_switch_count >= max_switch_count)

            if is_malignant_overflow or is_benign_overflow:
                # ★ 核心防线：只有恶性空转才允许累加死锁惩罚！挑食退房绝不累加！
                if is_malignant_overflow:
                    continuous_overflow_count += 1

                # ==========================================
                # ★ 全局死锁熔断器：连续 3 次防溢出 (即假滑 24 次)
                # ==========================================
                if continuous_overflow_count >= 3:
                    self.t_print("全局死锁",
                                 f"连续 {continuous_overflow_count} 轮触发防溢出重置！判定滑动功能已彻底失效或大厅污染！",
                                 self.C_RED)

                    # 1. 启动 ANR 专项扫描
