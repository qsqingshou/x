    def _match_template_in_roi_custom(self, img_gray, template_gray, threshold=0.80):
        """
        [局部微距匹配引擎] 专用于弹窗击杀舱，支持 Canny 轮廓图与普通灰度图匹配
        """
        if template_gray is None or img_gray is None or img_gray.size == 0:
            return None
        # 防止切出的 ROI 结界比模板本身还小
        if template_gray.shape[0] > img_gray.shape[0] or template_gray.shape[1] > img_gray.shape[1]:
            return None

        import cv2
        res = cv2.matchTemplate(img_gray, template_gray, cv2.TM_CCOEFF_NORMED)
        _, max_v, _, max_l = cv2.minMaxLoc(res)

        if max_v >= threshold:
            fh, fw = template_gray.shape[:2]
            gx, gy = max_l[0], max_l[1]
            return {'cx': gx + fw // 2, 'cy': gy + fh // 2, 'w': fw, 'h': fh, 'score': max_v}
        return None

