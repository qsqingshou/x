    def ensure_in_home(self, device_id):
        self.n_print("导航", "正在执行 '归位操作' (回首页)...")
        max_retries = 4

        for i in range(max_retries):
            self.op.get_screenshot(device_id)
            sc = self.op.cv_imread("pic/screenshot.png")

            # 直接使用纯 OCR 引擎极速确权
            if self.find_text_ui(sc, 'nav_home'):
                self.n_print("导航", "已确认在首页")
                return True

            if self.find_text_ui(sc, 'nav_me') or self.find_text_ui(sc, 'profile_follow'):
                h, w = sc.shape[:2]
                self.n_print("动作", "发现个人中心特征 -> 点击左下角 '首页' 归位")
