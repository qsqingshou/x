    def load_template_images(self):
        """
        [性能重构] 初始化时直接计算模板全局缩放比例，阻断运行时的无意义缩放算力消耗。
        """
        # print(">>> [系统] 预加载并计算模板全局缩放比例...")
        ratio = self.dm.ratio if self.dm else 1.0

        for key, info in self.templates.items():
            path = os.path.join(self.pic_dirs[info.get('dir', 'common')], info['f'])
            if os.path.exists(path):
                img = self.op.cv_imread(path)
                # O(1) 静态处理：在启动时直接将图片缩放到目标设备比例
                if ratio != 1.0:
                    nh, nw = int(img.shape[0] * ratio), int(img.shape[1] * ratio)
                    img = cv2.resize(img, (nw, nh), interpolation=cv2.INTER_AREA)

                info['image'] = img
                info['gray'] = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)  # 预转换并固化灰度图
                info['loaded'] = True
            else:
                info['loaded'] = False

    def match_template_multiscale_adaptive(self, screenshot, template_key, just_return_pos=False):
        """
        [V5.95 跨端微弹性匹配引擎]
        核心逻辑：使用 O(1) 预计算尺寸进行光速匹配。
        针对平板与手机的 DPI 渲染非线性畸变，引入 5 级弹性补偿队列。
        """
        if template_key not in self.templates: return None
        info = self.templates[template_key]
        if not info.get('loaded'): return None

        h, w = screenshot.shape[:2]

        y_min, y_max = 0, h
        if info.get('area') == 'top_left':
            y_max = int(h * 0.5)
        elif info.get('area') == 'top_half':
            y_max = int(h * 0.6)
        elif info.get('area') == 'bottom':
            y_min = int(h * 0.8)
        # ★★★ 新增：专门针对福袋任务面板的下半屏裁切 ★★★
        elif info.get('area') == 'bottom_half':
            y_min = int(h * 0.6)  # 物理切掉屏幕最上方 60% 的画面
            y_max = int(h * 0.98)  # 避开最底部的一点点系统边缘

        roi = screenshot[y_min:y_max, 0:w]
        if roi.size == 0: return None

        roi_gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
        base_tpl_gray = info['gray']
        # [可手动调节] 基础阈值，针对平板建议降至 0.60 以兼容畸变
        threshold = info.get('th', 0.60)

        # 弹性缩放序列：首选 1.0(预计算尺寸)，若失败则向两侧以 10% 步进寻找
        # 能够完美兼容平板屏幕带来的非线性 DPI 放大/缩小
        scales_to_try = [1.0, 0.9, 1.1, 0.8, 1.2]

        for scale in scales_to_try:
            if scale == 1.0:
                tpl_gray = base_tpl_gray
            else:
                nh = int(base_tpl_gray.shape[0] * scale)
                nw = int(base_tpl_gray.shape[1] * scale)
                if nh <= 0 or nw <= 0: continue
                tpl_gray = cv2.resize(base_tpl_gray, (nw, nh), interpolation=cv2.INTER_AREA)

            if tpl_gray.shape[0] > roi_gray.shape[0] or tpl_gray.shape[1] > roi_gray.shape[1]:
                continue

            res = cv2.matchTemplate(roi_gray, tpl_gray, cv2.TM_CCOEFF_NORMED)
            min_v, max_v, min_l, max_l = cv2.minMaxLoc(res)

            if max_v >= threshold:
                fh, fw = tpl_gray.shape[:2]
                gx, gy = max_l[0], y_min + max_l[1]

                if just_return_pos:
                    return {'tl': (gx, gy), 'h': fh}

                if 'rgb' in info:
                    crop = screenshot[gy:gy + fh, gx:gx + fw]
                    if not self._verify_rgb(crop, info['rgb']):
                        continue

                        # 打印补偿日志，若频繁触发非 1.0，说明预加载的 ratio 计算需手动偏移
                if scale != 1.0:
                    # print(f"   [自适应] {template_key} 触发微弹性补偿 (scale: {scale}, 得分: {max_v:.2f})")
                    pass

                return {'cx': gx + fw // 2, 'cy': gy + fh // 2, 'tl': (gx, gy), 'w': fw, 'h': fh}

        return None

    def match_festival_icon_adaptive(self, screenshot, template_name, threshold=None):
        """
        [节日福袋专属雷达] - 终极像素对齐版 (100%还原测试舱逻辑)
        """
        info = self.templates.get(template_name)
        if not info: return None

        filepath = os.path.join('config_pic', info['dir'], info['f'])
        if not os.path.exists(filepath): return None

        template_color = cv2.imdecode(np.fromfile(filepath, dtype=np.uint8), cv2.IMREAD_COLOR)
        if template_color is None: return None
        tpl_gray = cv2.cvtColor(template_color, cv2.COLOR_BGR2GRAY)

        th = threshold if threshold else info['th']

        if len(screenshot.shape) == 3:
            img_gray = cv2.cvtColor(screenshot, cv2.COLOR_BGR2GRAY)
        else:
            img_gray = screenshot

        h_img, w_img = img_gray.shape[:2]
        y_max = int(h_img * 0.4)
        roi_gray = img_gray[0:y_max, 0:w_img]
        if roi_gray.size == 0: return None

        h_tpl, w_tpl = tpl_gray.shape[:2]
        scales = [1.0, 0.9, 1.1, 0.8, 1.2]

        best_match_overall = None
        highest_score = -1.0

        for scale in scales:
            nw, nh = int(w_tpl * scale), int(h_tpl * scale)
            if nw <= 0 or nh <= 0: continue
            curr_tpl = cv2.resize(tpl_gray, (nw, nh), interpolation=cv2.INTER_AREA)

            if curr_tpl.shape[0] > roi_gray.shape[0] or curr_tpl.shape[1] > roi_gray.shape[1]:
                continue

            res = cv2.matchTemplate(roi_gray, curr_tpl, cv2.TM_CCOEFF_NORMED)
            _, max_v, _, max_l = cv2.minMaxLoc(res)

            if max_v > highest_score:
                highest_score = max_v
                fh, fw = curr_tpl.shape[:2]

                best_match_overall = {
                    'cx': max_l[0] + fw // 2,
                    'cy': max_l[1] + fh // 2,
                    'tl': max_l,
                    'w': fw, 'h': fh,
                    'score': max_v,
                    'scale': scale
                }

        if highest_score > 0.4:
            #print(f">>> [雷达探针] 寻找 {info['f']} -> 当前最高分: {highest_score:.3f} (及格线:{th})")
            pass

        if highest_score >= th and best_match_overall is not None:
            return best_match_overall

        return None

    def find_text_ui(self, sc, ui_key):
        if not hasattr(self, 'ui_dict'):
            self.ui_dict = self._init_ui_dict()

        if ui_key not in self.ui_dict: return None
        cfg = self.ui_dict[ui_key]

        h, w = sc.shape[:2]
        r = cfg['roi']

        x1, y1 = int(w * r[0]), int(h * r[1])
        x2, y2 = int(w * r[2]), int(h * r[3])

        roi_img = sc[y1:y2, x1:x2]
        if roi_img.size == 0: return None

        res_ocr = self.op.ocr.ocr(roi_img, cls=False)
        if not res_ocr or not res_ocr[0]: return None

        all_text = "".join([line[1][0] for line in res_ocr[0]])

        if 'aux' in cfg:
            if not any(aux_word in all_text for aux_word in cfg['aux']):
                return None

            # ★ 极微创注入：默认使用原生列表；仅当寻找底部导航时，临时将其降序重排
        scan_list = res_ocr[0]
        if ui_key in ['nav_me', 'nav_home']:
            scan_list = sorted(scan_list, key=lambda item: (item[0][0][1] + item[0][2][1]) / 2, reverse=True)

        # 这里的 res_ocr[0] 改为 scan_list，内部逻辑逐字保留，不作任何更改
        for line in scan_list:
            text = line[1][0]
            if any(kw in text for kw in cfg['kw']):
                box = line[0]
                w = box[2][0] - box[0][0]
                h = box[2][1] - box[0][1]

                # 同样留出 15% 安全区
                sx = int(w * 0.15)
                sy = int(h * 0.15)

                # 在外框内部大面积随机
                rx = int(box[0][0]) + random.randint(sx, max(sx, int(w) - sx)) + x1
                ry = int(box[0][1]) + random.randint(sy, max(sy, int(h) - sy)) + y1

                return {'text': text, 'cx': rx, 'cy': ry, 'box': box}

        return None

    def _verify_rgb(self, img, target_rgb):
        if img.size == 0: return False
        avg = np.mean(img, axis=(0, 1))
        dist = np.sqrt(sum((avg[i] - target_rgb[2 - i]) ** 2 for i in range(3)))
        return dist <= 70

    def _cmd_listener(self):
        """[新增] Windows 专属全局原生键盘监听舱 (无延迟、免回车)"""
        import msvcrt
        import time
        while True:
            try:
                # 侦测是否有按键被按下
                if msvcrt.kbhit():
                    key = msvcrt.getch()

                    # 1. 捕获方向键 (Windows下方向键会先发送 b'\xe0' 或 b'\x00')
                    if key in [b'\xe0', b'\x00']:
                        ext_key = msvcrt.getch()
                        if ext_key == b'H':  # ↑ 上方向键
                            print("\n>>> [指令] 捕获到【↑ 方向键】，即将强制切房...")
                            self.force_switch_flag = True

                    # 2. 捕获普通字母键 (自动转小写兼容大小写键盘)
                    else:
                        char = key.lower()
                        if char == b'n':
                            print("\n>>> [指令] 捕获到【N 键】，即将强制切房...")
                            self.force_switch_flag = True
                        elif char == b'p':
                            # 反转暂停状态：True变False，False变True
                            self.pause_flag = not getattr(self, 'pause_flag', False)
                            if self.pause_flag:
                                print("\n>>> [状态切换] 脚本已【暂停】！请再次按 P 键恢复运行。")
                            else:
                                print("\n>>> [状态切换] 脚本已【继续】运行！")

                # 极短的休眠，防止死循环把 CPU 吃满
                time.sleep(0.05)
            except:
                pass

