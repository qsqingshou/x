    def _search_fudai_loop(self):
        for i in range(4):
            # print(f">>> [搜索] 第 {i + 1}/4 轮...")
            if not self.op.get_screenshot(self.device_id): continue
            sc = self.op.cv_imread("pic/screenshot.png")
            # ★ 排雷：防止底层 API 假死返回空图片或畸形矩阵
            if sc is None or sc.size == 0: continue
            h, w = sc.shape[:2]

            if self.match_template_multiscale_adaptive(sc, 'room_live_ended'):
                self.t_print("状态", "直播已结束")
                return None

            # ==========================================
            # ★ 模式 2：YOLO 视觉引擎接管 (全屏秒速扫描)
            # ==========================================
            if self.detect_mode == 2 and self.yolo_model is not None:
                results = self.yolo_model(sc, verbose=False)
                best_conf = 0
                best_box = None
                best_cls = -1

                for box in results[0].boxes:
                    conf = float(box.conf[0])
                    if conf > 0.80:
                        x1, y1, x2, y2 = map(int, box.xyxy[0])
                        cy = y1 + (y2 - y1) // 2

                        # 终极防线：福袋绝不可能出现在屏幕下半部分！
                        if cy < h * 0.60:
                            if conf > best_conf:
                                best_conf = conf
                                best_box = box
                                best_cls = int(box.cls[0])
                        else:
                            self.t_print("AI 拦截", f"底部公屏发现福袋特效 (置信度:{conf:.2f}, 高度:{cy})，已屏蔽！")

                if best_box is not None:
                    x1, y1, x2, y2 = map(int, best_box.xyxy[0])
                    w_box, h_box = x2 - x1, y2 - y1
                    cx, cy = x1 + w_box // 2, y1 + h_box // 2
                    res_pos = {'cx': cx, 'cy': cy, 'tl': (x1, y1), 'w': w_box, 'h': h_box}

                    if best_cls == 0:
                        return 'SUPER', res_pos
                    elif best_cls == 1:
                        return 'NORMAL', res_pos
                    elif best_cls == 2:
                        # ★ 核心映射：YOLO 认出是新年福袋，我们直接当成 FESTIVAL 上报给大一统引擎！
                        return 'FESTIVAL', res_pos
                    elif best_cls == 3:
                        return 'FESTIVAL', res_pos

            # ==========================================
            # ★ 模式 1：传统灰度模板引擎接管 (轻量化扫描)
            # ==========================================
            else:
                # 1. 优先找超级福袋 (★ 优化：优先匹配新版 v2 图标，提高现网命中率)
                res_super = self.match_template_multiscale_adaptive(sc, 'super_fudai_icon_v2')
                if not res_super:
                    # 如果新版没找到，再用老版图标兜底
                    res_super = self.match_template_multiscale_adaptive(sc, 'super_fudai_icon')

                if res_super and res_super['cy'] < h * 0.40:
                    return 'SUPER', res_super

                # 2. 其次找普通福袋
                res_normal = self.match_template_multiscale_adaptive(sc, 'normal_fudai_icon')
                if res_normal and res_normal['cy'] < h * 0.40:
                    return 'NORMAL', res_normal

                # 3. 大一统扫描：节日福袋专属皮肤雷达
                for fest_key in ['festival_fudai_icon_zhuli', 'festival_fudai_icon_38', 'festival_fudai_icon_spring', 'festival_fudai_icon_new']:
                    res_festival = self.match_festival_icon_adaptive(sc, fest_key)
                    if res_festival and res_festival['cy'] < h * 0.40:
                        return 'FESTIVAL', res_festival

            self.op.delay(8)

        return None

    def process_normal_super_fudai(self, ftype, wait_min, allow_fans, allow_diamond, action_area_height=370, action_area_box=None, min_prize_value=0, ignore_value_filter=False, enable_super=True, enable_normal=True, is_reloading=False, normal_action_area_height=280, normal_action_area_box=None, time_area_box=None, vip_keywords=None):
        if vip_keywords is None:
            vip_keywords = []
        """
        [V6.9.5 终极隔离版] 独立三维提取舱 + 底部动作区绝对隔离
        """
        # ==========================================
        # ★ ROI 空间缓存引擎初始化 (光速重载专供)
        # ==========================================
        if not hasattr(self, 'super_roi_cache'):
            self.super_roi_cache = {}
        # 如果是新福袋（非重载），清空上一轮的坐标记忆
        if not is_reloading:
            self.super_roi_cache.clear()

        #print(f">>> [纯视觉引擎] 启动 {ftype} 福袋全景分析...")
        # ==========================================
        # ★ 双轨兼容引擎：全面重构！优先用 OCR 探新版，再用模板探老版
        # ==========================================
        self.op.get_screenshot(self.device_id)
        sc = self.op.cv_imread("pic/screenshot.png")
        if sc is None: return "SKIP"

        h, w = sc.shape[:2]
        is_new_ui = False
        anchor = None
        current_f_id = "单福袋"

        # ★ 1. 优先使用 OCR 极速扫描中上部，强力拦截新版 UI！(防止老模板假阳性误判)
        roi_mid = sc[int(h * 0.2):int(h * 0.75), 0:w]
        res_mid = self.op.ocr.ocr(roi_mid, cls=False)
        if res_mid and res_mid[0]:
            mid_text = "".join([line[1][0] for line in res_mid[0]])
            if "超级福袋" in mid_text and ("任务抽取" in mid_text or "完成任务" in mid_text):
                #self.t_print("视觉", "检测到新版文本福袋，已拦截并切换至新版解析引擎！", self.C_YELLOW, indent=1)
                is_new_ui = True
                ftype = 'SUPER'

                # 强行伪造一个虚拟锚点供关面板使用
                for line in res_mid[0]:
                    if "超级福袋" in line[1][0]:
                        box = line[0]
                        anchor = {'tl': (int(box[0][0]), int(box[0][1]) + int(h * 0.2)),
                                  'h': int(box[2][1] - box[0][1])}
                        break

        # ★ 2. 如果确定不是新版，再去匹配老版的图片模板！
        anchor_super = None
        anchor_normal = None
        anchor_tuangou = None

        if not is_new_ui:
            anchor_super = self.match_template_multiscale_adaptive(sc, 'fudai_anchor')
            anchor_normal = self.match_template_multiscale_adaptive(sc, 'normal_fudai_title')
            anchor_tuangou = self.match_template_multiscale_adaptive(sc, 'tuangou_fudai_title')

        if not anchor_super and not anchor_normal and not anchor_tuangou and not is_new_ui:
            if self.match_template_multiscale_adaptive(sc, 'yicanyu_btn'):
                self.t_print("物理兜底", "总网关标题变异，极速雷达锁定'已参与'按钮，强行移交普通引擎！")
                anchor_normal = {'tl': (0, int(h * 0.25)), 'h': 0}
            else:
                return "OPEN_PANEL_FAILED"

        # ==========================================
        # ★ 路由分发器
        # ==========================================
        if anchor_tuangou:
            self.t_print("过滤", "识别到团购福袋，配置为不参与，直接无视并关闭！")
            self._close_fudai_window(anchor_tuangou)
            return "SKIP"

        if is_new_ui:
            return self._process_new_super_fudai_engine(
                sc, anchor, wait_min, allow_fans, allow_diamond,
                min_prize_value, ignore_value_filter, is_reloading
            )

        elif anchor_normal:
            if is_reloading and ftype == 'SUPER':
                anchor = anchor_normal  # 防夺权
            elif not enable_normal:
                self.t_print("过滤拦截", "配置拒绝普通福袋，关闭！")
                self._close_fudai_window(anchor_normal)
                return "SKIP"

            if not is_reloading:
                self.t_print("福袋确认", "面板已打开，标题判定为：★普通福袋★", indent=1)

            return self.process_normal_fudai(
                wait_min, allow_fans, allow_diamond,
                min_prize_value=min_prize_value,
                ignore_value_filter=ignore_value_filter,
                vip_keywords=getattr(self, 'vip_keywords', []),
                action_area_height=normal_action_area_height,
                action_area_box=normal_action_area_box,
                is_reloading=is_reloading
            )

        elif anchor_super:
            # ★ 找回老版超级福袋的通道！不 Return，直接放行到下面！
            anchor = anchor_super
            if not is_reloading:
                self.t_print("福袋确认", "面板已打开，标题判定为：★超级福袋★", indent=1)

        else:
            return "OPEN_PANEL_FAILED"  # 面板没打开或闪退，呼叫外层重载

        tl = anchor.get('tl', (0, 0))
        h_val = anchor.get('h', 0)
        y_start = int(tl[1]) + int(h_val)

        visited_ids = set()
        wait_time_pool = []
        diamond_skipped = False  # ★ 新增：记录是否遇到了因没给钱而跳过的福袋
        low_value_skipped = False  # ★ 修复地雷：提前到循环外声明，积累全局拦截原因！
        time_skipped = False  # ★ 修复地雷：提前到循环外声明，积累全局拦截原因！
        empty_retry_count = 0  # ★ 新增：老设备加载重试计数器
        task_deadlock_dict = {}  #局部风控记录器！
        unknown_retry_dict = {}  # ★ 新增：防系统弹窗遮挡记录器

        # ==========================================
        # 🔄 横向多卡片遍历引擎
        # ==========================================
        while True:
            # ★ 新增：深度穿透打断！哪怕福袋已经打开正在扫描，也能瞬间撕毁当前任务！
            if getattr(self, 'force_switch_flag', False):
                self.t_print("强制干预", "放弃解析当前福袋，强行撤退...")
                self._close_fudai_window(anchor)  # 顺手关掉福袋面板
                return "FORCE_BREAK"  # 返回一个新信号，直接逃逸
            self.op.get_screenshot(self.device_id)
            sc = self.op.cv_imread("pic/screenshot.png")

            # ★ 排雷：防止多福袋遍历时 USB 数据流闪断导致 sc 为空
            if sc is None:
                self.op.delay(1.0)
                continue

            # ==========================================
            # ★ 弹窗突发拦截器：极限卡点开奖捕获
            # ==========================================
            if is_reloading:
                if self.match_template_multiscale_adaptive(sc, 'lijilingqu') or \
                        self.match_template_multiscale_adaptive(sc, 'zhidaole'):
                    # print(f">>> [突发开奖] 任务重载时福袋已当场开奖！中止解析，移交开奖捕获引擎...")
                    self._wait_for_open_loop(ftype=ftype)  # 直接呼叫监控引擎点击弹窗
                    self._close_fudai_window(anchor)  # 关掉底部的福袋面板
                    return "DRAW_FINISHED"  # 完美收官，进入长休眠

            # ★ [V7.0 Beta 2 修复] 每次重入循环，重新确认福袋标题还在不在！
            anchor_key = 'fudai_anchor'
            current_anchor = self.match_template_multiscale_adaptive(sc, anchor_key)

            if not current_anchor:
                # ==========================================
                # ★ 核心升级 2：极速缓存护盾！(极限压榨：关闭一切重试)
                # ==========================================
                if is_reloading:
                    fast_check_success = False

                    # 💡 物理外挂：如果有缓存的坐标，直接切出邮票大小的图片极速扫码！
                    if 'bottom_box' in getattr(self, 'super_roi_cache', {}):
                        bx1, by1, bx2, by2 = self.super_roi_cache['bottom_box']
                        # 上下左右各放宽 20 像素，完美包容 UI 的轻微弹性抖动
                        bx1 = max(0, bx1 - 20)
                        bx2 = min(w, bx2 + 20)
                        by1 = max(0, by1 - 20)
                        by2 = min(h, by2 + 20)

                        roi_tiny = sc[by1:by2, bx1:bx2]
                        res_tiny = self.op.ocr.ocr(roi_tiny, cls=False)
                        tiny_text = "".join([line[1][0] for line in res_tiny[0]]) if res_tiny and res_tiny[0] else ""

                        if any(kw in tiny_text for kw in ["中途离开", "请留在", "资格"]):
                            current_anchor = anchor
                            fast_check_success = True
                            # self.t_print("空间缓存", "命中底部记忆坐标，0.1秒光速确权成功！", self.C_YELLOW, indent=1)

                    # ★ 极限测试版：完全关闭底线重试和全图兜底！
                    # 只要缓存没命中，连 1 毫秒都不等，直接抛出重载失败信号，让外层光速重开！
                    if not fast_check_success:
                        #self.t_print("护盾熔断", "未命中缓存坐标，放弃死等，光速退回重开！", self.C_YELLOW, indent=1)
                        return "OPEN_PANEL_FAILED_RELOAD"
                else:
                    # 不是在重载阶段没找到，那就直接认定没打开
                    return "OPEN_PANEL_FAILED"

            self.anchor_retry_count = 0
            # 动态更新提取天花板，防止 UI 发生微小位移
            y_start = current_anchor['tl'][1] + current_anchor['h']

            roi_fudai = sc[y_start:h, 0:w]
            ocr_res = self.op.ocr.ocr(roi_fudai, cls=False)

            if not ocr_res or not ocr_res[0]:
                # ★ 如果没扫到任何内容，说明老设备卡白屏了，进入缓冲重试
                if empty_retry_count < 3:
                    self.t_print("缓冲", f"面板内容正在渲染，等待 2 秒重试 ({empty_retry_count + 1}/3)...")
                    self.op.delay(2.0)
                    empty_retry_count += 1
                    continue
                else:
                    self.t_print("异常", "提取舱视觉迷失，网络或设备极度卡顿，放弃解析！")
                    break
            else:
                # 只要成功扫到了文字，计数器立刻清零
                empty_retry_count = 0

            # ==========================================
            # ★ 恢复：全景侦测日志输出
            # ==========================================
            full_text_debug = "".join([line[1][0] for line in ocr_res[0]])
            #print(f">>> [全景侦测] '{full_text_debug}'")

            # 1. 抓取“福袋X”身份证
            is_multi = False
            current_f_id = "单福袋"
            for line in ocr_res[0]:
                txt = line[1][0].strip()
                if any(k in txt for k in ["福袋一", "福袋二", "福袋三", "福袋四", "福袋五"]):
                    current_f_id = txt
                    is_multi = True
                    break

            if current_f_id in visited_ids:
                # print(">>> [多福袋] 遍历到底，已无新福袋卡片。")
                break

            #print(f">>> [提取舱] 开始解析: 【{current_f_id}】")

            # 2. 三维舱提取
            y_top_limit = 0
            y_bottom_limit = h - y_start
            x_left_limit = 0
            x_right_limit = w

            fudai_total_seconds = 0
            final_time = ""
            ref_value_str = "未知"
            ref_num = 0

            if not hasattr(self, 'fudai_time_cache'): self.fudai_time_cache = {}
            if not hasattr(self, 'fudai_anchor_cache'): self.fudai_anchor_cache = {}

            # ==========================================
            # ★ 提取倒计时与物理锚点
            # ==========================================
            y_time_center = 0
            x_time_anchor = w
            x_right_edge = w
            time_text_full = ""
            extracted_seconds = 0

            # 1. 扫描全图，寻找雷达中心 (★ T2 极速制导升级版)
            # 如果是重载，且 T1 已经记录了物理坐标，直接进行 GPS 盲狙！绝不依赖文字！
            if is_reloading and current_f_id in getattr(self, 'fudai_anchor_cache', {}):
                saved_y_center_abs, saved_x_anchor, saved_x_right_edge = self.fudai_anchor_cache[current_f_id]
                # 将绝对 Y 坐标转换回当前切片的相对 Y 坐标
                y_time_center = saved_y_center_abs - y_start
                x_time_anchor = saved_x_anchor
                x_right_edge = saved_x_right_edge
                # self.t_print("雷达制导", "T2 启动空间记忆，直接锁定倒计时物理坐标！", indent=1)
            else:
                # 如果是新福袋(T1)，或者缓存意外丢失，才去老老实实扫描“后/开奖”字样
                for line in ocr_res[0]:
                    if "后" in line[1][0] or "开奖" in line[1][0]:
                        y_time_center = (line[0][0][1] + line[0][2][1]) / 2
                        x_time_anchor = line[0][0][0]
                        x_right_edge = line[0][2][0]
                        break

            if y_time_center > 0:
                # ★ 核心修复 1：强制刷新提取天花板，彻底阻断倒计时数字流入奖品名字！
                y_top_limit = y_time_center + self.dm.scale(25)

                if time_area_box and len(time_area_box) == 2:
                    left_range = self.dm.scale(time_area_box[0])
                    y_pad = self.dm.scale(time_area_box[1])

                    # ★ 核心修复 2：放弃二次截图 OCR，直接在全局 ocr_res 中进行物理坐标过滤！
                    # 彻底解决小图裁切导致的 PaddleOCR 幻视问题（如 13:15 认成 15:05）
                    time_lines = []
                    for line in ocr_res[0]:
                        box = line[0]
                        cx = (box[0][0] + box[2][0]) / 2
                        cy = (box[0][1] + box[2][1]) / 2
                        if abs(cy - y_time_center) < y_pad and (x_time_anchor - left_range) < cx < (x_right_edge + 20):
                            time_lines.append(line)

                    time_lines = sorted(time_lines, key=lambda x: x[0][0][0])
                    time_text_full = " ".join([line[1][0] for line in time_lines])

                else:
                    # 原来自适应逻辑网
                    time_lines = []
                    y_tolerance = self.dm.scale(25)
                    for line in ocr_res[0]:
                        box = line[0]
                        cy = (box[0][1] + box[2][1]) / 2
                        cx = (box[0][0] + box[2][0]) / 2
                        if abs(cy - y_time_center) < y_tolerance:
                            if cx < (x_time_anchor + self.dm.scale(20)):
                                time_lines.append(line)
                    time_lines = sorted(time_lines, key=lambda x: x[0][0][0])
                    time_text_full = " ".join([line[1][0] for line in time_lines])

            # 正则解析引擎
            if time_text_full:
                # ★ 第一处替换：先消除所有空格防截断，再精准狙击冒号！
                clean_time_text = time_text_full.replace(" ", "")
                match = re.search(r'(\d+)[:：](\d+)', clean_time_text)
                if match:
                    minutes = int(match.group(1))
                    seconds = int(match.group(2))
                    if seconds >= 60: seconds = 59
                    extracted_seconds = minutes * 60 + seconds
                else:
                    t_res = self.op.check_countdown(time_text_full)
                    if t_res:
                        extracted_seconds = t_res[0]
                    else:
                        # ==========================================
                        # ★ 极简纯数字倒推引擎 (T1/T2)
                        # ==========================================
                        pure_digits = re.sub(r'\D', '', time_text_full)
                        if pure_digits:
                            # 安全截断：最多保留最后 4 位数字 (最大支持 99分59秒)
                            if len(pure_digits) > 5:
                                pure_digits = pure_digits[-5:]

                            # 倒推切割算法
                            if len(pure_digits) <= 2:
                                extracted_seconds = int(pure_digits)
                            else:
                                minutes = int(pure_digits[:-2])
                                seconds = int(pure_digits[-2:])
                                # 容错防爆：如果秒数被错认为 60 以上，强制封顶为 59
                                if seconds >= 60: seconds = 59
                                extracted_seconds = minutes * 60 + seconds

            # ==========================================
            # ★ 终极三重冗余表决引擎 (TMR: T1 vs T2 vs T3)
            # ==========================================
            if not is_reloading:
                # 【T1阶段】第一次进房
                self.fudai_time_cache[current_f_id] = time.time() + extracted_seconds

                # ★ 修复 2：存入供 T3 决胜局复用的坐标时，必须把相对 Y 轴转化为全屏的绝对 Y 轴！
                if y_time_center > 0:
                    self.fudai_anchor_cache[current_f_id] = (y_time_center + y_start, x_time_anchor, x_right_edge)
                fudai_total_seconds = extracted_seconds
            else:
                # 【T2阶段】做完任务的重载验证
                T1_end_timestamp = self.fudai_time_cache.get(current_f_id, time.time() + 60)
                T2_extracted_seconds = extracted_seconds
                T1_seconds_left = max(0, int(T1_end_timestamp - time.time()))

                if T2_extracted_seconds > 0:
                    diff = abs(T2_extracted_seconds - T1_seconds_left)

                    # ==========================================
                    # ★ 新增：时光倒流物理约束 (防 T1 初始幻视)
                    # 时间只能越变越小！如果 T2 居然比 T1_seconds_left 还要大超过 5 秒 (5秒为网络加载容错)，
                    # 100% 说明 T1 当初看错了！直接强制打破 40 秒的信任区，逼迫启动 T3 终极复核！
                    # ==========================================
                    if T2_extracted_seconds > (T1_seconds_left + 10):
                        self.t_print("时空悖论",
                                     f"物理违规！T2({T2_extracted_seconds}s) 竟大于 T1剩余({T1_seconds_left}s)！T1疑似初始幻视，强制破盾！")
                        diff = 999  # 强行破坏 <= 40 秒的信任条件，逼迫进入 T3 裁决

                    if diff <= 40:
                        fudai_total_seconds = T1_seconds_left
                    else:
                        self.t_print("裁决",
                                     f"时间分歧过大或物理违规 ({T1_seconds_left}s vs {T2_extracted_seconds}s)，启动第三次复核...")
                        self.op.delay(1.5)
                        self.t_print("裁决", "正在获取最新画面帧...")
                        self.op.get_screenshot(self.device_id, silent=True)
                        sc_3 = self.op.cv_imread("pic/screenshot.png")

                        T3_extracted_seconds = 0

                        # ==========================================
                        # ★ T3 阶段：动态物理裁切 + 视觉强化舱 (专攻超级福袋红底白字)
                        # ==========================================
                        anchor_data = self.fudai_anchor_cache.get(current_f_id)
                        t3_text = ""

                        if anchor_data and sc_3 is not None and sc_3.size > 0:
                            # 取出 T1 时期存入的全屏绝对坐标
                            saved_y_center_abs, saved_x_anchor, saved_x_right_edge = anchor_data

                            if time_area_box and len(time_area_box) == 2:
                                left_range = self.dm.scale(time_area_box[0])
                                # ★ 动态扩容：应对几十秒挂机后 UI 的轻微上下偏移，将 T3 的 Y 轴容错扩大 1.5 倍
                                y_pad = self.dm.scale(time_area_box[1]) * 1.5

                                crop_x1 = max(0, int(saved_x_anchor - left_range))
                                crop_x2 = min(w, int(saved_x_right_edge + 20))
                                crop_y1 = max(0, int(saved_y_center_abs - y_pad))
                                crop_y2 = min(h, int(saved_y_center_abs + y_pad))

                                hard_box_3 = sc_3[crop_y1:crop_y2, crop_x1:crop_x2]

                                # 确保切出来的图片不是幽灵矩阵
                                if hard_box_3.size > 0:
                                    # --------------------------------------------------
                                    # ★ T3 视觉强化：纯白像素剥离引擎 (防动态干扰最强方案)
                                    # --------------------------------------------------
                                    h_b, w_b = hard_box_3.shape[:2]

                                    # 1. 插值放大：先将像素撑大，防止过滤后笔画太细断裂
                                    resize_factor = 2
                                    enhanced_box = cv2.resize(hard_box_3, (w_b * resize_factor, h_b * resize_factor),
                                                              interpolation=cv2.INTER_LINEAR)

                                    # --------------------------------------------------
                                    # ★ 升级方案 1：高反差保留与自适应二值化 (零内存暴增版)
                                    # --------------------------------------------------
                                    # 1. 转为纯灰度图
                                    gray_box = cv2.cvtColor(enhanced_box, cv2.COLOR_BGR2GRAY)

                                    # 2. 高斯模糊提取背景光晕
                                    blurred = cv2.GaussianBlur(gray_box, (0, 0), 1.0)

                                    # 3. 高反差保留：用原图减去光晕，瞬间抹平抖音的花哨渐变底色！
                                    high_pass = cv2.addWeighted(gray_box, 1.5, blurred, -0.5, 0)

                                    # 4. 自适应阈值二值化：针对数字轮廓进行精准切割 (去除了硬编码的颜色限制)
                                    binary = cv2.adaptiveThreshold(high_pass, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
                                                                   cv2.THRESH_BINARY, 11, 2)

                                    # 5. 形态学闭运算：把 OCR 容易认错的残缺笔画强行焊接起来
                                    kernel = np.ones((2, 2), np.uint8)
                                    mask_white = cv2.morphologyEx(binary, cv2.MORPH_CLOSE, kernel)

                                    # ==========================================
                                    # 3. ★ 终极进化：既然二值图已完美无瑕，直接呼叫 RapidOCR 主炮！
                                    # 彻底弃用 CnOCR，免疫汉字“强制脑补”引发的幻视灾难！
                                    # ==========================================
                                    res_3 = self.op.ocr.ocr(mask_white, cls=False)
                                    t3_text = ""
                                    if res_3 and res_3[0]:
                                        t3_lines = sorted(res_3[0], key=lambda x: x[0][0][0])
                                        t3_text = " ".join([line[1][0] for line in t3_lines])

                            else:
                                # (未配置 time_area_box 的备用方案)
                                res_3 = self.op.ocr.ocr(sc_3, cls=False)
                                if res_3 and res_3[0]:
                                    t3_lines = []
                                    y_tol = self.dm.scale(35)  # T3 阶段容错同样放大到 35px
                                    for line in res_3[0]:
                                        cy = (line[0][0][1] + line[0][2][1]) / 2
                                        if abs(cy - saved_y_center_abs) < y_tol:
                                            t3_lines.append(line)
                                    t3_lines = sorted(t3_lines, key=lambda x: x[0][0][0])
                                    t3_text = " ".join([line[1][0] for line in t3_lines])

                        # 解析 T3 时间
                        if t3_text:
                            # ★ 第二处替换：先消除所有空格防截断，再精准狙击冒号！
                            clean_t3_text = t3_text.replace(" ", "")
                            match_t3 = re.search(r'(\d+)[:：](\d+)', clean_t3_text)
                            if match_t3:
                                minutes = int(match_t3.group(1))
                                seconds = int(match_t3.group(2))
                                if seconds >= 60: seconds = 59
                                T3_extracted_seconds = minutes * 60 + seconds
                            else:
                                # ==========================================
                                # ★ 极简纯数字倒推引擎 (T3)
                                # ==========================================
                                t_res = self.op.check_countdown(t3_text)
                                if t_res:
                                    T3_extracted_seconds = t_res[0]
                                else:
                                    pure_digits_t3 = re.sub(r'\D', '', t3_text)
                                    if pure_digits_t3:
                                        if len(pure_digits_t3) > 5:
                                            pure_digits_t3 = pure_digits_t3[-5:]

                                        if len(pure_digits_t3) <= 2:
                                            T3_extracted_seconds = int(pure_digits_t3)
                                        else:
                                            minutes = int(pure_digits_t3[:-2])
                                            seconds = int(pure_digits_t3[-2:])
                                            if seconds >= 60: seconds = 59
                                            T3_extracted_seconds = minutes * 60 + seconds

                        # 三方表决计算
                        if T3_extracted_seconds > 0:
                            self.t_print("裁决", f"T3 决胜局提取完毕：{T3_extracted_seconds}s")
                            diff_to_T1 = abs(T3_extracted_seconds - T1_seconds_left)
                            diff_to_T2 = abs(T3_extracted_seconds - T2_extracted_seconds)

                            # ★ 核心修复：加入“时间坍缩”常识护盾！
                            # 如果 T2 的时间比 T1 骤减了超过 60 秒，这在物理上是不可能的，100%是被动画遮挡了！
                            if (T1_seconds_left - T2_extracted_seconds) > 60:
