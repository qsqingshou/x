    def t_print(self, tag, msg, color='', indent=0):
        """专属彩色时间轴打印机 (纯净 ASCII 极客风)"""
        import datetime
        t_str = datetime.datetime.now().strftime("%H:%M:%S")
        # 彻底抛弃拉胯的制表符，改用纯净的 ASCII 空格和折叠箭头
        prefix = "   " * indent + ("> " if indent > 0 else "")
        # 时间和内容之间，用最干净的竖线 | 隔开
        print(f"{color}{t_str} | {prefix}[{tag}] {msg}{self.C_RESET}")

