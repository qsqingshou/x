class Tee(object):
    def __init__(self, terminal, log_file):
        self.terminal = terminal
        self.log_file = log_file
        # 预编译正则：专门用于捕获并剔除 ANSI 颜色控制符
        import re
        self.ansi_escape = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')

    def write(self, obj):
        # 1. 终端正常输出（保留颜色）
        self.terminal.write(obj)
        self.terminal.flush()
        # 2. 日志文件输出（剔除颜色代码，干干净净！）
        clean_obj = self.ansi_escape.sub('', obj)
        self.log_file.write(clean_obj)
        self.log_file.flush()

    def flush(self):
        self.terminal.flush()
        self.log_file.flush()

class periodic_cleanup:
    def __init__(self, cleanup_interval_operations=50):
        self.cleanup_interval = cleanup_interval_operations
        self.last_cleanup_operation_count = 0
        self.cleanup_config = {
            'max_pic_files': 20,
            'pic_dirs': ['pic', 'debug_pic'],
            'log_rotation_size_mb': 10
        }

    def check_and_cleanup(self, current_operations):
        if current_operations - self.last_cleanup_operation_count >= self.cleanup_interval:
            for d in self.cleanup_config['pic_dirs']:
                self._clean_dir(d)
            self.last_cleanup_operation_count = current_operations

    def _clean_dir(self, dir_path):
        if not os.path.exists(dir_path): return
        try:
            files = [os.path.join(dir_path, f) for f in os.listdir(dir_path)
                     if (f.endswith('.png') or f.startswith('debug_')) and 'win_' not in f] # ★ 绝对不删中奖截图！
            files.sort(key=os.path.getmtime)
            if len(files) > self.cleanup_config['max_pic_files']:
                for f in files[:-self.cleanup_config['max_pic_files']]:
                    try:
                        os.remove(f)
                    except:
                        pass
        except:
            pass


class DeviceManager:
    def __init__(self, device_id):
        self.device_id = device_id
        self.config_dir = "config"
        if not os.path.exists(self.config_dir): os.makedirs(self.config_dir)
        self.config_path = os.path.join(self.config_dir, f"device_{device_id}.json")

        self.base_width = 1080.0
        self.ratio = 1.0

        self.data: dict = self._load_config()
        if self.data.get("resolution"):
            w, h = self.data["resolution"]
            self.ratio = w / self.base_width

    def _load_config(self):
        if os.path.exists(self.config_path):
            try:
                with open(self.config_path, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except:
                pass
        return {"resolution": None, "coordinates": {}}

    def save_config(self):
        with open(self.config_path, 'w', encoding='utf-8') as f:
            json.dump(self.data, f, indent=4, ensure_ascii=False)

    def update_resolution(self, w, h):
        self.data["resolution"] = [w, h]
        self.ratio = w / self.base_width
        # print(f">>> [自适应] 分辨率: {w}x{h} | 缩放系数: {self.ratio:.2f}")
        self.save_config()

    def scale(self, value):
        return int(value * self.ratio)

    def _get_res_suffix(self):
        """获取当前分辨率后缀，用于区分全面屏和导航栏状态"""
        if self.data.get("resolution"):
            w, h = self.data["resolution"]
            return f"{w}x{h}"
        return "default"

    def get_coordinate(self, key):
        # 动态组装 Key，例如： home_live_square_pos_1080x2400
        real_key = f"{key}_{self._get_res_suffix()}"
        return self.data["coordinates"].get(real_key)

    def set_coordinate(self, key, coords):
        real_key = f"{key}_{self._get_res_suffix()}"
        self.data["coordinates"][real_key] = coords
        self.save_config()


