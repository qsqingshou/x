        self.nav = NavigationManager(self.op, self.templates, self.match_template_multiscale_adaptive, self.dm, self.find_text_ui)

        modes = {0: "固定直播间", 1: "关注列表", 2: "直播广场", 3: f"搜索: {search_kw}"}
        print(f">>> [启动] V5.5  | 模式: {modes.get(run_mode, '未知')}")
        #print(f">>> [配置] 普通等待: {wait_min_normal}m | 超级等待: {wait_min_super}m")
        current_time = datetime.datetime.now().strftime("%H:%M")
        battery = self.op.get_battery_level(device_id)
