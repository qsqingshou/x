        if not tab_y_cache:
            self.n_print("寻址", "未发现 Tab 高度缓存，扫描顶部推荐/关注...")
            # 只截取顶部 20% 区域进行 OCR，极速且防止扫到下方视频的文字
            roi_top = sc[0:int(h * 0.2), 0:w]
            res_ocr = self.op.ocr.ocr(roi_top, cls=False)
            if res_ocr and res_ocr[0]:
                for line in res_ocr[0]:
                    text = line[1][0]
                    # 只要扫到这些常驻的标签词，立刻锁定它们的高度！
                    if any(kw in text for kw in ["推荐", "关注", "商城", "经验", "同城"]):
                        tab_y = int((line[0][0][1] + line[0][2][1]) / 2)
                        self.n_print("寻址", f"成功锁定顶部 Tab 栏 Y 坐标: {tab_y}")
                        # 存入配置，DeviceManager 会自动区分全面屏和导航栏！
                        self.dm.set_coordinate('home_top_tab_y', [0, tab_y])
                        tab_y_cache = [0, tab_y]
                        break

        if not tab_y_cache:
            self.n_print("失败", "无法锁定顶部 Tab 栏高度！")
            return False

        tab_y = tab_y_cache[1]  # 取出缓存的 Y 坐标
        self.n_print("缓存", f"启用顶部 Tab 高度缓存: Y = {tab_y}")

        # ==========================================
        # ★ 第二步：在锁定的 Y 轴高度“隧道”内扫描与滑动
        # ==========================================
        # 圈出以 Tab 高度为中心，上下各扩展 40px 的狭长“隧道”
        y_min = max(0, tab_y - self.dm.scale(40))
        y_max = min(h, tab_y + self.dm.scale(40))

        def find_live_tab(img):
            # 专心扫隧道，速度极快
            roi = img[y_min:y_max, 0:w]
            res = self.op.ocr.ocr(roi, cls=False)
            if res and res[0]:
                for line in res[0]:
                    if "直播" in line[1][0]:
                        cx = int((line[0][0][0] + line[0][2][0]) / 2)
                        cy = int((line[0][0][1] + line[0][2][1]) / 2) + y_min
                        return [cx, cy]
            return None

        target_pos = find_live_tab(sc)

        if target_pos:
            found_entry = True
            self.n_print("锁定", f"直接发现 '直播' Tab: {target_pos}")
        else:
            self.n_print("滑动", "横向滑动寻找直播 Tab...")
            # “直播”通常在“推荐”的左侧，所以手指要在 Tab 栏区域向右狠狠滑！
            for i in range(4):
                self.n_print("滑动", f"第 {i + 1} 次向右拉扯 Tab 栏...")
                # 沿着隧道高度 (tab_y)，手指从屏幕左侧 30% 滑到右侧 80%，把左边隐藏的东西拖出来
                self.op.swipe_custom(device_id, int(w * 0.3), tab_y, int(w * 0.8), tab_y, duration=300)
                self.op.delay(2)

                self.op.get_screenshot(device_id, silent=True)
                sc_retry = self.op.cv_imread("pic/screenshot.png")
                target_pos = find_live_tab(sc_retry)
                if target_pos:
                    found_entry = True
                    self.n_print("锁定", f"滑动后成功发现 '直播' Tab: {target_pos}")
                    break

        if not found_entry:
            self.n_print("失败", "横向滑动多次未找到直播，可能被遮挡")
            return False

        # ==========================================
        # ★ 第三步：点击进入并兜底
        # ==========================================
        self.n_print("动作", f"点击直播广场入口: {target_pos}")
        self.op.click(device_id, target_pos)
        self.op.delay(4)

        # 进房逻辑
        self.op.get_screenshot(device_id)
        sc = self.op.cv_imread("pic/screenshot.png")
        if self.check_is_in_live_room(sc):
            self.n_print("成功", "已直接进入直播间")
            return True

        # 如果卡在列表页 -> 上滑 -> 点中心
        self.n_print("列表", "正在加载更多直播间...")
        # 自下部中心向上滑 (为了显示完整)
        self.op.swipe_custom(device_id, w // 2, int(h * 0.8), w // 2, int(h * 0.4))
        self.op.delay(2)

        # 随机点击中心周边
        click_x = w // 2 + random.randint(-50, 50)
        click_y = h // 2 + random.randint(-50, 50)
        self.n_print("动作", f"随机点击列表: ({click_x}, {click_y})")
        self.op.click(device_id, (click_x, click_y))
        self.op.delay(5)

        return True

    # --- 模式三：关键词搜索 (新逻辑) ---
    def enter_search_live(self, device_id, keyword):
        self.n_print("导航", f"模式三：搜索关键词 '{keyword}'")
        if not self.ensure_in_home(device_id): return False

        # 1. 点击放大镜
        self.op.get_screenshot(device_id)
        sc = self.op.cv_imread("pic/screenshot.png")
        res = self.match(sc, 'nav_search_icon')
        if res:
            self.op.click(device_id, (res['cx'], res['cy']))
            self.op.delay(2)
        else:
            self.n_print("错误", "未找到搜索图标")
            return False

        # 2. 输入关键词
        self.n_print("输入", f"{keyword}")
        self.op.input_text(device_id, keyword)
        self.op.delay(1)

        # 3. 点击搜索 (回车 或 按钮)
        self.n_print("动作", "点击搜索/回车")
        # 优先尝试 ADB 回车
        self.op.send_enter(device_id)
        self.op.delay(3)

        # 检查是否还在输入页 (如果有备用按钮)
        self.op.get_screenshot(device_id)
        sc = self.op.cv_imread("pic/screenshot.png")
        btn = self.match(sc, 'btn_search_submit')
        if btn:
            self.n_print("备用", "点击屏幕上的搜索按钮")
            self.op.click(device_id, (btn['cx'], btn['cy']))
            self.op.delay(3)

        # 4. 筛选 "直播"
        # 锚点：tab_general (综合)
        # 范围：搜索按钮/框 下方
        # 逻辑：先找综合，再向右找直播

        found_tab = False

        # A. 确定顶部范围 (利用搜索按钮的位置大致估算，或者直接 OCR 上半屏)
        # 简化：直接找 "综合"
        gen_tab = self.match(sc, 'tab_general')
        if gen_tab:
            # 范围线：综合的右侧
            search_y_line = gen_tab['cy']
            search_x_start = gen_tab['tl'][0] + gen_tab['w']

            # 向右找 "直播"
            # 截取综合所在水平条
            h, w = sc.shape[:2]
            y_min = max(0, gen_tab['tl'][1] - 20)
            y_max = gen_tab['tl'][1] + gen_tab['h'] + 20

            # OCR 寻找
            raw_res = self.op.ocr.ocr(sc[y_min:y_max, search_x_start:w], cls=False)
            if raw_res and raw_res[0]:
                for line in raw_res[0]:
                    if "直播" in line[1][0]:
                        cx = int((line[0][0][0] + line[0][2][0]) / 2) + search_x_start
                        cy = int((line[0][0][1] + line[0][2][1]) / 2) + y_min
                        self.n_print("动作", "点击 '直播' Tab")
                        self.op.click(device_id, (cx, cy))
                        found_tab = True
                        break

        # B. 滑动查找 (如果 A 没找到)
        if not found_tab and gen_tab:
            self.n_print("搜索", "未找到直播Tab，向左滑动导航栏...")
            y_swipe = gen_tab['cy']
            w = sc.shape[1]
            # 向左滑 (显示右侧内容): 中心 -> 左
            for i in range(5):
                self.op.swipe_custom(device_id, w // 2, y_swipe, w // 2 - self.dm.scale(300), y_swipe)
                self.op.delay(2)

                self.op.get_screenshot(device_id)
                sc_retry = self.op.cv_imread("pic/screenshot.png")
                # 识别 nav_search_live_text
                res = self.match(sc_retry, 'nav_search_live_text')
                if res:
                    self.n_print("动作", "点击 '直播' Tab (滑动后)")
                    self.op.click(device_id, (res['cx'], res['cy']))
                    found_tab = True
                    break

        if not found_tab:
            self.n_print("失败", "无法定位到 '直播' 分类，停止脚本")
            return False

        self.op.delay(3)

        # 5. 进入直播间
        # 点击屏幕中心偏上 (第一个结果)
        self.n_print("动作", "进入第一个搜索结果")
        h, w = sc.shape[:2]
        self.op.click(device_id, (w // 2, int(h * 0.4)))
        self.op.delay(5)

        # 状态确认 (三重校验)
        self.op.get_screenshot(device_id)
        sc = self.op.cv_imread("pic/screenshot.png")
        if self.check_is_in_live_room(sc):
            return True
        else:
            self.n_print("失败", "未能进入直播间")
            return False

    # --- 通用：直播间全景多维校验 (V13 极客全能确权版) ---
    def check_is_in_live_room(self, sc):
        h, w = sc.shape[:2]

        # ==========================================
        # 1. 绝对特权：只要有福袋，100% 是直播间
        # ==========================================
        if self.match(sc, 'fudai_anchor') or \
                self.match(sc, 'normal_fudai_title') or \
                self.match(sc, 'super_fudai_icon') or \
                self.match(sc, 'super_fudai_icon_v2'):  # ★ 新增
            return True

        # ==========================================
        # 2. 底部特征：图标三剑客 (OR 逻辑) + "说点什么" (直播间灵魂)
        # ==========================================
        # ★ 核心增强：新增 room_huang_box 判定，实现全类型直播间图标兼容！
        has_chat_icon = self.match(sc, 'room_chat_box') or \
                        self.match(sc, 'room_xin_box') or \
                        self.match(sc, 'room_huang_box')

        roi_chat = (0, int(h * 0.88), int(w * 0.5), h)
        chat_text = self.op.analyse_area_text(sc, roi_chat, "")
        has_chat_text = any(word in chat_text for word in ["说点什么", "说点什", "说点"])

        # ==========================================
        # 3. 顶部特征：提取动态天花板区域文字
        # ==========================================
        cached_y = self.dm.get_coordinate('fudai_min_y')
        search_bottom_y = cached_y[1] if cached_y else int(h * 0.18)
        search_bottom_y = max(search_bottom_y, int(h * 0.10))

        roi_top = (0, 0, int(w * 0.5), search_bottom_y)
        top_text = self.op.analyse_area_text(sc, roi_top, "")

        # 强特征词 (短视频绝无可能出现)
        strong_live_kws = ["小时榜", "人气榜", "本场榜", "带货总榜", "榜第", "挑战榜", "本场点赞", "影响力", "7天无理由", "服务保障", "好评率", "有上新", "抖音旗舰"]
        # 弱特征词
        weak_live_kws = ["万点赞", "万本场", "贡献"]

        has_strong_kw = any(word in top_text for word in strong_live_kws)
        has_weak_kw = any(word in top_text for word in weak_live_kws)

        # ==========================================
        # 4. 终极确权逻辑 (三维交叉验证，严防热启动误判)
        # ==========================================
        # ★ 逻辑 D (新增)：物理特权！只要在【福袋天花板】以上的绝对安全区内，发现任意 1 个强词，直接秒批！
        if has_strong_kw:
            return True

        # 逻辑 A：有底部图标(三选一) + (底部文字 OR 任意顶部关键词) -> 极稳
        if has_chat_icon and (has_chat_text or has_strong_kw or has_weak_kw):
            return True

        # 逻辑 B：虽然没认出图标，但底部文字 和 顶部强关键词 同时出现 -> 稳
        if has_chat_text and has_strong_kw:
            return True

        # 逻辑 C：顶部出现了至少 2 个强特征词 -> 稳
        match_count = sum(1 for word in strong_live_kws if word in top_text)
        if match_count >= 2:
            return True

        return False


