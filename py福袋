        if not wait_time_pool:
            if diamond_skipped: return "SKIP_DIAMOND"
            if time_skipped: return "SKIP_TIMEOUT"
            if near_death_skipped: return "DRAW_FINISHED_NO_COUNT"  # ★ 核心修复：返回白嫖挂机信号，死守大奖绝不切房！
            return "SKIP"
        else:
            min_timestamp = min(wait_time_pool)
            min_wait = max(0, int(min_timestamp - time.time()))

            # 是否在面板上发现了多个不同的奖品指纹？
            is_panel_multi = len(visited_prizes) > 1

            wait_result = self._smart_sleep_and_wait(min_wait, ftype='SUPER', is_multi=is_panel_multi)

            if wait_result in ["ROOM_DEAD", "FORCE_BREAK", "EARLY_WAKEUP"]: return wait_result

            if len(wait_time_pool) > 1:
                return "MULTI_DRAW_PARTIAL"
            else:
                return "DRAW_FINISHED"

