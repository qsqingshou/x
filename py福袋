            else:
                self.t_print("状态更新", f"普通福袋正在确认开奖状态 | 剩余时间: {fudai_total_seconds}s")

            if re.search(r'\d+级及以上', condition_full_text) or "提升亲密度" in full_text:
                self.t_print("拦截", "发现流氓等级或亲密度任务")
