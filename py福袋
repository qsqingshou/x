                            if grp_bot: hit_kws.append("底部")
                            hit_str = "+".join(hit_kws) if not long_sentence_match else "绝对长句"

                            self.t_print("中奖", f"OCR交叉确权成功({hit_str}) -> 截图留档: {filename}",
                                         self.C_MAGENTA)
                            self.op.cv_imwrite(filename, sc)

                            # ==========================================
                            # ★ 智能推送区：节日福袋独立逻辑
                            # ==========================================
                            # ==========================================
                            # ★ [架构升级] 字典时间匹配算法 (取代单体变量)
                            # ==========================================
                            final_prize_info = "未知大奖"
                            prize_value = 0
                            current_ts = time.time()
                            best_diff = 9999
                            best_match_key = None

                            for ts_key, data in self.multi_prize_memory.items():
                                diff = abs(ts_key - current_ts)
                                if diff < 45 and diff < best_diff:  # 45秒容错区间
                                    best_diff = diff
                                    best_match_key = ts_key

                            if best_match_key:
                                matched_data = self.multi_prize_memory[best_match_key]
                                prize_value = matched_data['value']
                                if isinstance(matched_data['prize'], list):
                                    self.last_structured_prizes = matched_data['prize']
                                    final_prize_info = "节日大奖待确权"
                                else:
                                    final_prize_info = matched_data['prize']

                            final_sc = sc  # 兜底原图

                            if ftype == 'FESTIVAL':
                                #self.t_print("动态提取", "节日福袋触发，启动抗飘窗扫描引擎 (最高15秒)...", indent=1)
                                start_time = time.time()
                                extracted = False

                                while time.time() - start_time < 15:
                                    self.op.get_screenshot(self.device_id, silent=True)
                                    sc_clean = self.op.cv_imread("pic/screenshot.png")
                                    if sc_clean is None:
                                        self.op.delay(1)
                                        continue

                                    final_sc = sc_clean
                                    h_sc, w_sc = sc_clean.shape[:2]
                                    roi_win = sc_clean[int(h_sc * 0.3):int(h_sc * 0.7), int(w_sc * 0.1):int(w_sc * 0.9)]
                                    res_win = self.op.ocr.ocr(roi_win, cls=False)

                                    if res_win and res_win[0]:
                                        temp_full_text = "".join([line[1][0] for line in res_win[0]])

                                        # ★ 核心：检测官方飘窗特征词，触发物理避让
                                        if any(kw in temp_full_text for kw in
                                               ["新福袋已投放", "上期活动可前往"]):
                                            #self.t_print("飘窗拦截", "发现官方顶部飘窗遮挡，等待其消散...", indent=2)
                                            self.op.delay(1.5)
                                            continue

                                        # 飘窗消失后，提取干净的奖品名
                                        ignore = ["恭喜", "抽中", "福袋", "领取", "立即", "奖品", "协议", "隐私",
                                                  "政策", "填写", "地址", "我知道了"]
                                        valid_txts = [l[1][0] for l in res_win[0] if
                                                      not any(k in l[1][0] for k in ignore) and len(l[1][0]) > 2]

                                        if valid_txts:
                                            memory = getattr(self, 'last_structured_prizes', [])

                                            # ==========================================
                                            # ★ 核心隔离：利用前置记忆库进行“双向过滤”
                                            # ==========================================
                                            for m_prize in memory:
                                                # 剥离出记忆库里干净的奖品名，例如 "华为手机"
                                                name_in_mem = re.split(r'[:：]', m_prize)[-1].split('(')[0].strip()

                                                # 遍历本次 OCR 扫出来的所有碎文字
                                                for scanned_text in valid_txts:
                                                    # 双向包含测试：如果扫出来的字是记忆的一部分，或者是记忆是它的一部分
                                                    # 图片上的 "官方正品" 永远匹配不上 "华为手机"，被完美隔离！
                                                    if scanned_text in name_in_mem or name_in_mem in scanned_text:
                                                        final_prize_info = m_prize
                                                        extracted = True
                                                        break

                                                if extracted:
                                                    break

                                            # ==========================================
                                            # ★ 终极兜底：基于“48小时内领取”的物理空间倒推
                                            # ==========================================
                                            if not extracted:
                                                fallback_name = ""
                                                anchor_y = -1

                                                # 1. 寻找“48小时”锚点
                                                for line in res_win[0]:
                                                    if "48小时" in line[1][0] or "内领取" in line[1][0]:
                                                        anchor_y = line[0][0][1]  # 记录锚点的顶部 Y 坐标
                                                        break

                                                # 2. 找到了锚点，寻找它正上方挨得最近的那行字！
                                                if anchor_y != -1:
                                                    closest_y_dist = 9999
                                                    for line in res_win[0]:
                                                        text = line[1][0]
                                                        cy = (line[0][0][1] + line[0][2][1]) / 2
                                                        # 必须在锚点上方，且不能是过滤词
                                                        if cy < anchor_y and not any(
                                                                k in text for k in ignore) and len(text) >= 2:
                                                            dist = anchor_y - cy
                                                            if dist < closest_y_dist:
                                                                closest_y_dist = dist
                                                                fallback_name = text

                                                # 3. 极限兜底：如果万一没找到 48 小时锚点，或者上面没字，再退回挑最长
                                                if not fallback_name:
                                                    if valid_txts:
                                                        fallback_name = max(valid_txts, key=len)
                                                    else:
                                                        fallback_name = "未知大奖"

                                                final_prize_info = f"疑似奖品: {fallback_name}"
                                                extracted = True  # 强行放行打破 15 秒死循环

                                    if extracted:
                                        #self.t_print("突破干扰", f"节日福袋提取成功: {final_prize_info}！", indent=2)
                                        break
                                    else:
                                        self.op.delay(1.0)

                            else:
                                # 普通/超级福袋 (利用绝对记忆体，但也要等飘窗消失，为了截取一张干净好看的中奖图)
                                for _ in range(5):
                                    self.op.get_screenshot(self.device_id, silent=True)
                                    sc_clean = self.op.cv_imread("pic/screenshot.png")
                                    if sc_clean is not None:
                                        final_sc = sc_clean
                                        res_clean = self.op.ocr.ocr(sc_clean, cls=False)
                                        if res_clean and res_clean[0]:
                                            temp_full_text = "".join([line[1][0] for line in res_clean[0]])
                                            if any(kw in temp_full_text for kw in
                                                   ["新福袋已投放", "上期活动可前往"]):
                                                #self.t_print("飘窗拦截", "等待官方飘窗消散以获取干净截图...", indent=2)
                                                self.op.delay(1.5)
                                                continue
                                    break

                            # --- 执行最终的留档与推送 ---
                            ts = datetime.datetime.now().strftime("%Y-%m-%d-%H-%M-%S")
                            filename = f"pic/win_{ts}.png"
                            self.t_print("推送", f"获取最终画面 -> 截图留档: {filename}", self.C_MAGENTA, indent=1)
                            if final_sc is not None: self.op.cv_imwrite(filename, final_sc)

                            current_val = prize_value if 'prize_value' in locals() else getattr(self,'last_parsed_value', 0)
                            value_show = prize_value if prize_value > 0 else "未知"
                            alias_str = getattr(self, 'device_alias', self.device_id)

                            self.send_wechat_push(
                                title="🎉 抖音福袋中奖啦！",
                                content=f"<b>设备ID：</b>{self.device_id}<br><b>设备别名：</b>{alias_str}<br><b>战利品：</b><font color='#d93a49'><b>{final_prize_info}</b></font><br><b>价值：</b>{value_show} 馒头<br><b>中奖时间：</b>{ts}<br><br>快去手机上看一眼吧！"
                            )
                            self.op.adb_key_event(self.device_id, 4)
                            return
            except Exception as e:
                pass

            # ==========================================
            # ★ 你的核心思路落地：动态休眠区间
            # ==========================================
            if round_idx < (max_rounds - 1):
                # ★ 硬件双轨制：动态分配扫描帧率
                if self.performance_mode == 2:
                    delay_min, delay_max = 1.5, 2.8  # 高配极速连拍
                else:
                    delay_min, delay_max = 3.5, 6.5  # 低配防堵塞缓拍

                scan_cost = time.time() - scan_start
                if scan_cost > 3.0:
                    self.t_print("诊断", f"扫描耗时 {scan_cost:.2f}秒，通道拥堵，随机休眠 {delay_min}~{delay_max}秒")
                else:
                    self.t_print("扫描", f"暂未发现结果，缓冲 {delay_min}~{delay_max}秒 准备下一轮...", indent=1)

                self.op.delay(delay_min, delay_max)

        # ==========================================
        # ★ 兜底检测：连续 3 轮都没看到弹窗，执行状态确认 (极简静默版)
        # ==========================================
        self.op.get_screenshot(self.device_id, silent=True)
        sc_final = self.op.cv_imread("pic/screenshot.png")
        if sc_final is not None:
            # 1. 如果福袋还在，说明提前醒了，静默发送纠错信号
            # ★ 核心修复 3：多福袋并发时，屏幕必有其他图标，绝对禁止误判为“提前苏醒”！
            if not is_multi:
                if self.match_template_multiscale_adaptive(sc_final, 'super_fudai_icon') or \
                        self.match_template_multiscale_adaptive(sc_final, 'super_fudai_icon_v2') or \
                        self.match_template_multiscale_adaptive(sc_final, 'normal_fudai_icon') or \
                        self.match_template_multiscale_adaptive(sc_final, 'festival_fudai_icon_38') or \
                        self.match_template_multiscale_adaptive(sc_final, 'festival_fudai_icon_spring') or \
                        self.match_template_multiscale_adaptive(sc_final, 'festival_fudai_icon_new') or \
                        self.match_template_multiscale_adaptive(sc_final, 'festival_fudai_icon_zhuli'):  # ★ 补齐了助力版图标！
                    self.t_print("纠错拦截", "弹窗未出现且福袋存活！识别误差，准备重读...")
                    return "EARLY_WAKEUP"

            # 2. 如果画面已经脱离直播间，发死屏信号
            if not self.nav.check_is_in_live_room(sc_final):
                self.t_print("异常撤退", "画面已偏离直播间，立即向主控发送死屏信号！")
                return "ROOM_DEAD"

        # 3. 正常没中奖弹窗消失，完全闭嘴，安全退出监控
        return "OK"

    def send_wechat_push(self, title, content):
        """
        [V7.4 终极外挂专属] 双擎推送系统 (支持 PushPlus 与 WxPusher)
        """
        engine = getattr(self, 'push_engine', '').lower()

        # 封装一下内容，让推送到微信里的排版更好看
        html_content = f"<h3>{title}</h3><hr><p>{content}</p>"

        if engine == "pushplus":
            token = getattr(self, 'pushplus_token', '')
            if not token:
                self.t_print("推送", "未配置 PushPlus Token，跳过推送。")
                return

            # ★ 升级 1：使用更为安全的 https 协议，防止某些网络下被劫持或丢包
            url = "https://www.pushplus.plus/send"
            data = {
                "token": token,
                "title": title,
                "content": html_content,
                "template": "html"
            }

            try:
                # ★ 升级 2：将超时时间从 5 秒放宽到 10 秒
                response = requests.post(url, json=data, timeout=10)
                res_json = response.json()

                # ★ 升级 3：加入明确的成功打印，绝不静默！
                if response.status_code == 200 and res_json.get("code") == 200:
                    #print(f"\n>>> [微信推送] ✅ 消息已成功发送至微信！(主题: {title})\n")
                    pass
                else:
                    #print(f"\n>>> [微信推送] ❌ PushPlus 发送失败！接口返回信息: {res_json.get('msg')}\n")
                    pass
            except Exception as e:
                self.t_print("微信推送", f"PushPlus 网络异常或超时: {e}")

        elif engine == "wxpusher":
            app_token = getattr(self, 'wxpusher_app_token', '')
            uid = getattr(self, 'wxpusher_uid', '')

            if not app_token or not uid:
                self.t_print("推送", "未完整配置 WxPusher，跳过推送。")
                return

            url = "https://wxpusher.zjiecode.com/api/send/message"
            data = {
                "appToken": app_token,
                "content": html_content,
                "summary": title,  # 微信列表显示的摘要文字
                "contentType": 2,  # 1表示文字，2表示html，3表示markdown
                "uids": [uid]
            }

            try:
                response = requests.post(url, json=data, timeout=5)
                res_json = response.json()
                # WxPusher 成功状态码为 1000
                if response.status_code == 200 and res_json.get("code") == 1000:
                    pass
                else:
                    self.t_print("微信推送", f"WxPusher 发送失败: {res_json.get('msg')}")
            except Exception as e:
                self.t_print("微信推送", f"WxPusher 网络异常: {e}")

        else:
            self.t_print("推送", "推送功能已关闭或引擎配置错误。")

    def check_adb_health(self):
        """★ 升级：ADB 健康哨兵 (带 60秒 延迟确认与防骚扰冷却)"""
        try:
            cmd = f"adb -s {self.device_id} get-state"
            CREATE_NO_WINDOW = 0x08000000 if os.name == 'nt' else 0
            res = subprocess.check_output(cmd, shell=True, stderr=subprocess.STDOUT, timeout=5,
                                          creationflags=CREATE_NO_WINDOW).decode('utf-8').strip()

            if res != "device":
                raise Exception(f"状态异常: {res}")

            # 如果成功恢复连接，清零离线计时器
            if getattr(self, 'adb_offline_start_time', 0) > 0:
                self.t_print("哨兵", "ADB 连接已恢复正常！警报解除！", self.C_GREEN)
                self.adb_offline_start_time = 0  # 恢复健康，清零计时器
                self.is_adb_offline = False
            return True

        except Exception as e:
            now = time.time()

            # 1. 记录第一次断开的时间 (静默不报警，只打印黄字提示)
            if getattr(self, 'adb_offline_start_time', 0) == 0:
                self.adb_offline_start_time = now
                self.t_print("哨兵警告", f"检测到 ADB 闪断！进入 60 秒静默观察期...", self.C_YELLOW)
                return False

            # 2. 计算已经断开了多久
            offline_duration = now - self.adb_offline_start_time
            self.t_print("哨兵警告", f"ADB 持续失联中... 已断开 {int(offline_duration)} 秒", self.C_YELLOW)

            # 3. ★ 核心延迟确认机制：只有断开超过 60 秒，才真正判定为“死机”并发送微信推送！
            if offline_duration > 60:
                last_push = getattr(self, 'last_adb_push_time', 0)

                # ★ 防骚扰冷却机制：每隔 1 小时 (3600秒) 才推送一次报警
                if now - last_push > 3600:
                    self.t_print("致命错误", "观察期结束，ADB 彻底失联！正在发送微信告警...", self.C_RED)
                    error_time = datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')
                    push_title = f"[节点异常] {self.device_id} ADB彻底失联"
                    push_content = (
                        f"<b>设备编号:</b> {self.device_id}<br>"
                        f"<b>设备别名:</b> {getattr(self, 'device_alias', self.device_id)}<br>"
                        f"<b>报警时间:</b> {error_time}<br>"
                        f"<b>严重级别:</b> 致命 (脚本已挂起超过1分钟)<br>"
                        f"<b>故障详情:</b> 设备 ADB 连接已断开，且未能在 60 秒内自动恢复。<br>"
                        f"<b>建议操作:</b> 请立即检查 USB 数据线、重启模拟器或排查手机网络！"
                    )
                    self.send_wechat_push(title=push_title, content=push_content)
                    self.last_adb_push_time = now
                    self.is_adb_offline = True

            return False
