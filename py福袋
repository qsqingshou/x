                return "ROOM_DEAD"
            if wait_result == "FORCE_BREAK":
                return "FORCE_BREAK"
            if wait_result == "EARLY_WAKEUP":  # ★ 新增：传递纠错信号
                return "EARLY_WAKEUP"

            return "DRAW_FINISHED"

        def get_btns_in_range(h_limit):
            valid_btns = []
            # ★ V8.7 的绝对隔离框双轴锁定逻辑
            if action_area_box and len(action_area_box) == 4:
