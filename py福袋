                    self._close_fudai_window(anchor)
                    return "DRAW_FINISHED_NO_COUNT"  # ★ 返回成功信号：不切房，直接触发外层的连抽休眠期！

        # --- 阶段 4：动作探测与阶梯式隔离区 ---
        if is_finished:
            self.t_print("状态", "确认已参与，正在精准入池...", indent=1)
            exact_time = fudai_total_seconds if fudai_total_seconds > 0 else 60
            self._close_fudai_window(anchor)
            wait_result = self._smart_sleep_and_wait(exact_time, ftype='NORMAL')

            # ★ 核心拦截：如果开奖期间发现主播下播，直接返回死亡信号！
