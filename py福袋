    def _smart_sleep_and_wait(self, total_seconds, ftype='SUPER', is_multi=False):
        """
        [V9.3 绝对精准版] 智能休眠与开奖监控调度器
        """
        import datetime
        import random

        # ==========================================
        # ★ 核心修复：扣除老设备的“隐形处理时间”！
        # 截图+OCR通常消耗了6~8秒，必须从总睡眠时间里减掉，否则起步就晚了！
        # ==========================================
        hardware_offset = 7.0 if self.performance_mode != 2 else 2.0
        sleep_time = max(0, total_seconds - hardware_offset)

        open_time_dt = datetime.datetime.now() + datetime.timedelta(seconds=sleep_time)
        open_time_str = open_time_dt.strftime("%H时%M分%S秒")

        if sleep_time > 0:
            self.t_print("抽奖进度", f"预计开奖时间：{open_time_str}，进入低功耗深度休眠...", indent=1)
            self.soft_rescue_history.clear()  # ★ 熔断清零锚点：成功确权进入挂机业务，系统绝对健康！
            # 删除了以前会引发严重拖延的分块循环，直接调用升级后的神级引擎！
            self.op.delay(sleep_time)

            if getattr(self, 'force_switch_flag', False):
