                        self.t_print("特权激活", f"匹配到想要的奖品 '{kw}'，无视金额强行咬住！")
                    has_privilege = True
                    break

            # ★ 绝对护盾：如果在重载，禁止触发任何价值/黑名单拦截
            if not is_reloading:
                # 1. 【新增】黑名单防线：包含不想要的垃圾，直接划走！
